     6. HOW IT WORKS
     ========================================================================= */
  .studio-steps {
    background-color: var(--color-pepper-dark, #7C8363);
    padding: clamp(4rem, 8vw, 6rem) 0;
  }

  .studio-steps__header {
    margin-bottom: 2.5rem;
  }

  .studio-steps__title {
    font-family: var(--font-display, 'Space Grotesk', sans-serif);
