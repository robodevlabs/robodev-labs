  }

  .studio-pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .studio-pillar-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(212, 212, 212, 0.16);
    border-radius: 10px;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
