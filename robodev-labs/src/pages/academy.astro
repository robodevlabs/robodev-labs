    font-weight: 700;
    color: var(--color-salt-white, #EDF4F2);
    margin: 0;
  }

  .studio-pillar-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(237, 244, 242, 0.8);
    margin: 0;
  }

  .studio-outcomes__samples {
    border-top: 1px solid rgba(212, 212, 212, 0.16);
    padding-top: 2rem;
  }

  .studio-samples-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem 2rem;
  }

  .studio-sample-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: rgba(237, 244, 242, 0.85);
  }

