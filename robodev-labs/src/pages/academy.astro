    color: #b5d5ad;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* =========================================================================
     5. WHY ROBODEV ACADEMY
     ========================================================================= */
  .studio-why {
    position: relative;
    background-color: var(--color-pepper-medium, #31473A);
    padding: clamp(4rem, 8vw, 6.5rem) 0;
    overflow: hidden;
  }

  .studio-why__bg-artwork {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .studio-why__svg-grid {
    width: 100%;
    height: 100%;
  }

  .studio-why__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
