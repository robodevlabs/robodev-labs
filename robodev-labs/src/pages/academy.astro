---
/**
 * RoboDev Academy — Editorial Workshop Studio
 * Inspired by Maven, Frontend Masters, Skillshare, and MasterClass:
 * workshop-first, outcome-focused, strong typography, clear discovery,
 * premium editorial layout, driven 100% dynamically by src/data/workshops.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import AcademyOrbit from '../components/academy/AcademyOrbit.astro';
import AcademyGrid from '../components/academy/AcademyGrid.astro';
import AcademyNodes from '../components/academy/AcademyNodes.astro';
import AcademyBlueprint from '../components/academy/AcademyBlueprint.astro';
import AcademyPath from '../components/academy/AcademyPath.astro';
import AcademyWorkshopMark from '../components/academy/AcademyWorkshopMark.astro';
import { workshopsData } from '../data/workshops';
import { siteConfig } from '../config/site';
import ceoPhoto from '../assets/images/CEO Photo.png';

/* ── Dynamic Workshop Derivations ── */
const featured = workshopsData.find((w) => w.isFeatured) ?? workshopsData[0];
const allWorkshops = workshopsData;

/* Collect representative real outcomes from workshopsData */
const sampleOutcomes = [
  ...new Set(
    workshopsData.flatMap((w) => w.outcomes ?? []).filter(Boolean)
  ),
].slice(0, 6);

/* Collect primary instructor/founder from data or siteConfig */
const leadInstructor = {
  name: workshopsData[0]?.instructor ?? siteConfig.founder,
  title: workshopsData[0]?.instructorTitle ?? 'Founder & Lead Engineer, RoboDev Labs',
  bio: workshopsData[0]?.instructorBio ?? 'Safal is the founder of RoboDev Labs, a technology company focused on practical software, AI solutions, and opportunities for students and young engineers.',
};

/* ── JSON-LD: ItemList for Google rich results ── */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'RoboDev Academy Workshops',
  description: 'Practical digital and software workshops for beginners and early-career developers.',
  url: `${siteConfig.url}/academy`,
  itemListElement: workshopsData.map((w, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Course',
      name: w.title,
      description: w.description,
      url: `${siteConfig.url}/academy/courses/${w.slug}`,
      provider: {
        '@type': 'Organization',
        name: siteConfig.name,
        url: siteConfig.url,
      },
      courseMode: w.format.toLowerCase().includes('online') ? 'online' : 'blended',
      offers: {
        '@type': 'Offer',
        price: w.isFree ? '0' : (w.price.replace(/[^0-9.]/g, '') || '0'),
        priceCurrency: 'NPR',
        availability: 'https://schema.org/InStock',
        url: w.paymentUrl ?? w.registrationUrl,
      },
    },
  })),
};
---

<BaseLayout
  title="RoboDev Academy — Practical Workshops for Builders"
  description="Practical digital workshops for students and early-career developers. Learn AI automation, UI/UX in Figma, and SEO by building real deliverables."
>
  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="studio-page">
    <!-- ================================================================
         1. HERO — Confident, minimal editorial hero
         ================================================================ -->
    <header class="studio-hero academy-section" data-academy-section="hero">
      <!-- Layered Abstract SVG / Technical Geometry Artwork — 3-depth parallax -->
      <div class="studio-hero__backdrop" aria-hidden="true">
        <div class="studio-hero__glow" data-parallax="0.04"></div>
        <div class="studio-hero__blueprint-grid academy-grid-layer" data-parallax="0.06"></div>
        <div class="academy-orbit academy-orbit--back" data-parallax="0.1">
          <AcademyGrid class="academy-grid--hero" />
        </div>
        <svg class="studio-hero__geometry studio-hero__geometry--back" viewBox="0 0 1200 600" fill="none" preserveAspectRatio="xMidYMid slice" data-parallax="0.12">
          <circle cx="950" cy="180" r="320" stroke="rgba(212, 212, 212, 0.08)" stroke-width="1" stroke-dasharray="6 6" />
          <circle cx="950" cy="180" r="210" stroke="rgba(181, 213, 173, 0.12)" stroke-width="1.5" />
          <circle cx="950" cy="180" r="90" stroke="rgba(212, 212, 212, 0.1)" stroke-width="1" />
          <path d="M600,0 L950,180 L1200,60" stroke="rgba(212, 212, 212, 0.06)" stroke-width="1" />
          <path d="M820,380 L950,180 L1120,340" stroke="rgba(181, 213, 173, 0.08)" stroke-width="1" />
        </svg>
        <svg class="studio-hero__geometry studio-hero__geometry--front" viewBox="0 0 1200 600" fill="none" preserveAspectRatio="xMidYMid slice" data-parallax="0.2">
          <!-- Technical Crosshairs & Node points -->
          <circle cx="950" cy="180" r="4" fill="#b5d5ad" />
          <circle cx="820" cy="380" r="3" fill="rgba(237, 244, 242, 0.5)" />
          <circle cx="1120" cy="340" r="3" fill="rgba(237, 244, 242, 0.5)" />
          <line x1="930" y1="180" x2="970" y2="180" stroke="rgba(237, 244, 242, 0.4)" stroke-width="1" />
          <line x1="950" y1="160" x2="950" y2="200" stroke="rgba(237, 244, 242, 0.4)" stroke-width="1" />
          <text x="965" y="175" fill="rgba(212, 212, 212, 0.35)" font-family="monospace" font-size="10" letter-spacing="1">COORD::LABS-01</text>
          <text x="835" y="395" fill="rgba(212, 212, 212, 0.25)" font-family="monospace" font-size="9" letter-spacing="1">SEC//NODE</text>
        </svg>
        <div class="academy-node-field" data-parallax="0.28" aria-hidden="true">
          <AcademyNodes class="academy-nodes--hero" />
        </div>
      </div>

      <Container>
        <div class="studio-hero__layout">
        <div class="studio-hero__inner reveal-fade-up">
          <div class="studio-hero__meta-label">
            <span class="studio-eyebrow">ROBODEV ACADEMY</span>
          </div>

          <h1 class="studio-hero__headline">
            Learn by <em>building.</em>
          </h1>

          <p class="studio-hero__lead">
            Practical workshops for students and early-career developers who want to build real things, not just follow tutorials.
          </p>

          <div class="studio-hero__actions">
            <Button variant="primary" size="lg" href="#workshops" id="hero-explore-cta" class="studio-cta-btn">
              <span>Explore workshops</span>
              <span class="studio-arrow" aria-hidden="true">→</span>
            </Button>
            <a href="#how-it-works" class="studio-text-link" id="hero-how-it-works-link">
              How it works
            </a>
          </div>
        </div>
        <div class="studio-hero__anchor" aria-hidden="true" data-parallax="0.14">
          <div class="studio-hero__anchor-main">
            <AcademyBlueprint class="academy-blueprint--hero" />
          </div>
          <div class="studio-hero__anchor-orbit" data-parallax="0.22">
            <AcademyOrbit variant="hero" />
          </div>
        </div>
        </div>
      </Container>
    </header>

    <div class="studio-divider"><Container><hr /></Container></div>

    <!-- ================================================================
         2. FEATURED / UPCOMING WORKSHOP — Asymmetric editorial layout
         ================================================================ -->
    {featured && (
      <section class="studio-featured academy-section" id="featured" aria-labelledby="featured-workshop-title" data-academy-section="featured">
        <!-- Elevated background technical accent geometry + parallax depth -->
        <div class="studio-featured__bg-accents" aria-hidden="true">
          <svg class="studio-featured__corner-svg" viewBox="0 0 400 400" fill="none" data-parallax="0.08">
            <path d="M0,80 L80,80 L80,0" stroke="rgba(181, 213, 173, 0.18)" stroke-width="1.5" />
            <path d="M20,100 L100,100 L100,20" stroke="rgba(212, 212, 212, 0.08)" stroke-width="1" stroke-dasharray="4 4" />
            <circle cx="80" cy="80" r="3" fill="#b5d5ad" />
          </svg>
          <div class="academy-line-art academy-line-art--featured" data-parallax="0.12" aria-hidden="true">
            <AcademyGrid />
          </div>
          <div class="academy-orbit--featured" data-parallax="0.18" aria-hidden="true">
            <AcademyOrbit variant="card" />
          </div>
        </div>

        <Container>
          <div class="studio-section-header reveal-fade-up">
            <span class="studio-eyebrow">FEATURED WORKSHOP</span>
            <span class="studio-status-pill">
              <span class="studio-pulse-dot" aria-hidden="true"></span>
              {featured.status === 'open' ? 'Registration Open' : 'Upcoming Session'}
            </span>
          </div>

          <div class="studio-featured__grid">
            <!-- Left: Primary Editorial Narrative -->
            <div class="studio-featured__narrative reveal-fade-up">
              <div class="studio-featured__meta-strip">
                <span class="studio-tag">{featured.level}</span>
                <span class="studio-meta-sep" aria-hidden="true">/</span>
                <span class="studio-tag">{featured.duration}</span>
                <span class="studio-meta-sep" aria-hidden="true">/</span>
                <span class="studio-tag">{featured.format}</span>
                {featured.hasCertificate && (
                  <>
                    <span class="studio-meta-sep" aria-hidden="true">/</span>
                    <span class="studio-tag studio-tag--cert">Certificate included</span>
                  </>
                )}
              </div>

              <h2 class="studio-featured__title" id="featured-workshop-title">
                {featured.title}
              </h2>

              {featured.tagline && (
                <p class="studio-featured__tagline">
                  {featured.tagline}
                </p>
              )}

              {featured.outcomes && featured.outcomes.length > 0 && (
                <div class="studio-featured__outcomes-block">
                  <h3 class="studio-micro-heading">Key deliverables you will build</h3>
                  <ul class="studio-outcomes-list" aria-label="Workshop takeaways">
                    {featured.outcomes.slice(0, 3).map((outcome) => (
                      <li class="studio-outcome-item">
                        <span class="studio-outcome-check" aria-hidden="true">✓</span>
                        <span>{outcome}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="studio-featured__footer-link">
                <a href={`/academy/courses/${featured.slug}`} class="studio-link-arrow" id="featured-read-more-link">
                  <span>Explore full syllabus & workshop details</span>
                  <span class="studio-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </div>

            <!-- Right: Action & Enrollment Card — floating physical object -->
            <aside class="studio-featured__aside reveal-fade-up academy-float" aria-label="Session enrollment" data-parallax="0.05">
              <div class="studio-aside-card__halo" aria-hidden="true"></div>
              <div class="studio-aside-card">
                <div class="studio-aside-card__badge">Live Studio Session</div>

                <div class="studio-aside-card__price-wrap">
                  <span class="studio-aside-card__price-sub">Session Tuition</span>
                  <div class="studio-aside-card__price">
                    {featured.isFree ? 'Free' : featured.price}
                  </div>
                  <span class="studio-aside-card__price-note">
                    {featured.isFree ? '100% Free · No payment required' : 'One-time admission'}
                  </span>
                </div>

                <div class="studio-aside-card__details">
                  <div class="studio-aside-row">
                    <span class="studio-aside-label">Format</span>
                    <span class="studio-aside-val">{featured.format}</span>
                  </div>
                  <div class="studio-aside-row">
                    <span class="studio-aside-label">Duration</span>
                    <span class="studio-aside-val">{featured.duration}</span>
                  </div>
                  <div class="studio-aside-row">
                    <span class="studio-aside-label">Next Date</span>
                    <span class="studio-aside-val">{featured.date ?? 'To be announced'}</span>
                  </div>
                  {featured.instructor && (
                    <div class="studio-aside-row">
                      <span class="studio-aside-label">Mentor</span>
                      <span class="studio-aside-val">{featured.instructor}</span>
                    </div>
                  )}
                </div>

                <div class="studio-aside-card__actions">
                  <Button
                    variant="primary"
                    size="lg"
                    href={featured.paymentUrl ?? featured.registrationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="studio-aside-btn"
                    id="featured-enroll-cta"
                  >
                    <span>{featured.isFree ? 'Register — Free' : `Enroll — ${featured.price}`}</span>
                    <Icon name="arrow-right" size={15} />
                  </Button>

                  <a
                    href={`/academy/courses/${featured.slug}`}
                    class="studio-aside-link"
                    id="featured-course-page-cta"
                  >
                    Course details page
                  </a>
                </div>
              </div>
            </aside>
          </div>
        </Container>
      </section>
    )}

    <div class="studio-divider"><Container><hr /></Container></div>

    <!-- ================================================================
         3. WORKSHOP DISCOVERY — Editorial Card / List System
         ================================================================ -->
    <section class="studio-discovery academy-section" id="workshops" aria-labelledby="discovery-heading" data-academy-section="discovery">
      <div class="academy-ambient academy-ambient--discovery" aria-hidden="true" data-parallax="0.06">
        <AcademyGrid />
      </div>
      <Container>
        <div class="studio-discovery__header reveal-fade-up">
          <span class="studio-eyebrow">WORKSHOPS</span>
          <h2 class="studio-discovery__title" id="discovery-heading">
            Choose what you want to build next.
          </h2>
          <p class="studio-discovery__lead">
            Every session is focused on a tangible deliverable. Pick the topic that solves your immediate problem.
          </p>
        </div>

        <div class="studio-cards-stack" role="list">
          {allWorkshops.map((workshop, idx) => (
            <article class={`studio-card studio-card--variant-${idx % 3} reveal-fade-up academy-card-stagger`} role="listitem" style={`--reveal-delay:${idx * 70}ms`}>
              <!-- Index-derived visual identity: 01 circular / 02 grid / 03 layered -->
              <div class="studio-card__motif" aria-hidden="true">
                <AcademyWorkshopMark index={idx} />
              </div>
              <div class="studio-card__diagonal" aria-hidden="true"></div>

              <div class="studio-card__index-wrap" aria-hidden="true">
                <span class="studio-card__index">0{idx + 1}</span>
                <span class="studio-card__index-bar"></span>
              </div>

              <div class="studio-card__content">
                <div class="studio-card__top">
                  <div class="studio-card__meta">
                    <span class="studio-pill">{workshop.level}</span>
                    <span class="studio-pill">{workshop.duration}</span>
                    <span class="studio-pill">{workshop.format.split('·')[0].trim()}</span>
                    {workshop.hasCertificate && (
                      <span class="studio-pill studio-pill--cert">Certificate</span>
                    )}
                    {workshop.status === 'open' && (
                      <span class="studio-pill studio-pill--open">Open</span>
                    )}
                    {workshop.status === 'upcoming' && (
                      <span class="studio-pill studio-pill--upcoming">Upcoming</span>
                    )}
                  </div>
                  <div class="studio-card__price">
                    {workshop.isFree ? (
                      <span class="studio-price-free">Free</span>
                    ) : (
                      <span class="studio-price-val">{workshop.price}</span>
                    )}
                  </div>
                </div>

                <h3 class="studio-card__title">
                  <a href={`/academy/courses/${workshop.slug}`} class="studio-card__title-link">
                    {workshop.shortTitle ?? workshop.title}
                  </a>
                </h3>

                <p class="studio-card__desc">
                  {workshop.description}
                </p>

                {workshop.outcomes && workshop.outcomes.length > 0 && (
                  <div class="studio-card__preview-outcome">
                    <span class="studio-outcome-bullet" aria-hidden="true">↳</span>
                    <span>{workshop.outcomes[0]}</span>
                  </div>
                )}
              </div>

              <div class="studio-card__action">
                <a
                  href={`/academy/courses/${workshop.slug}`}
                  class="studio-explore-btn"
                  id={`explore-workshop-${workshop.id}`}
                >
                  <span>Explore workshop</span>
                  <span class="studio-arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <div class="studio-divider"><Container><hr /></Container></div>

    <!-- ================================================================
         4. OUTCOMES — "LEAVE WITH SOMETHING YOU BUILT."
         ================================================================ -->
    <section class="studio-outcomes academy-section" aria-labelledby="outcomes-heading" data-academy-section="outcomes">
      <div class="academy-ambient academy-ambient--outcomes" aria-hidden="true" data-parallax="0.07">
        <AcademyNodes />
      </div>
      <Container>
        <div class="studio-outcomes__header reveal-fade-up">
          <span class="studio-eyebrow">OUTCOMES</span>
          <h2 class="studio-outcomes__title" id="outcomes-heading">
            LEAVE WITH SOMETHING YOU BUILT.
          </h2>
          <p class="studio-outcomes__lead">
            We measure progress by shipped deliverables, not hours spent watching presentations.
          </p>
        </div>

        <div class="studio-pillars-grid">
          <div class="studio-pillar-card studio-pillar-card--build reveal-fade-up" style="--reveal-delay:0ms">
            <div class="studio-pillar-card__bg" aria-hidden="true"><AcademyWorkshopMark index={0} /></div>
            <div class="studio-pillar-card__top">
              <span class="studio-pillar-num">01</span>
              <svg class="studio-pillar-decor" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <rect x="4" y="4" width="24" height="24" stroke="rgba(181, 213, 173, 0.3)" stroke-width="1.5" />
                <circle cx="16" cy="16" r="4" fill="#b5d5ad" />
              </svg>
            </div>
            <h3 class="studio-pillar-title">Build a real project</h3>
            <p class="studio-pillar-desc">
              Every workshop centers on concrete implementation. You start with clear specifications and end with working software or a deployable interface.
            </p>
          </div>

          <div class="studio-pillar-card studio-pillar-card--learn reveal-fade-up" style="--reveal-delay:90ms">
            <div class="studio-pillar-card__bg" aria-hidden="true"><AcademyWorkshopMark index={1} /></div>
            <div class="studio-pillar-card__top">
              <span class="studio-pillar-num">02</span>
              <svg class="studio-pillar-decor" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <circle cx="16" cy="16" r="12" stroke="rgba(181, 213, 173, 0.3)" stroke-width="1.5" stroke-dasharray="3 3" />
                <path d="M16,8 L16,24 M8,16 L24,16" stroke="rgba(212, 212, 212, 0.3)" stroke-width="1" />
              </svg>
            </div>
            <h3 class="studio-pillar-title">Gain practical skills</h3>
            <p class="studio-pillar-desc">
              Learn the architectural patterns, debugging routines, and mental models that engineering teams use daily to turn ambiguous requirements into production systems.
            </p>
          </div>

          <div class="studio-pillar-card studio-pillar-card--continue reveal-fade-up" style="--reveal-delay:180ms">
            <div class="studio-pillar-card__bg" aria-hidden="true"><AcademyWorkshopMark index={2} /></div>
            <div class="studio-pillar-card__top">
              <span class="studio-pillar-num">03</span>
              <svg class="studio-pillar-decor" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <path d="M8,24 L16,8 L24,24 Z" stroke="rgba(181, 213, 173, 0.3)" stroke-width="1.5" />
                <circle cx="16" cy="18" r="3" fill="#b5d5ad" />
              </svg>
            </div>
            <h3 class="studio-pillar-title">Keep and continue building</h3>
            <p class="studio-pillar-desc">
              Your code and deliverables belong to you. Push to GitHub, integrate into client projects, or publish to your portfolio as proof of verified applied ability.
            </p>
          </div>
        </div>

        {sampleOutcomes.length > 0 && (
          <div class="studio-outcomes__samples reveal-fade-up">
            <h4 class="studio-micro-heading">Recent deliverables created in studio sessions</h4>
            <div class="studio-samples-grid">
              {sampleOutcomes.map((item) => (
                <div class="studio-sample-item">
                  <span class="studio-sample-dash" aria-hidden="true">—</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </Container>
    </section>

    <div class="studio-divider"><Container><hr /></Container></div>

    <!-- ================================================================
         5. WHY ROBODEV ACADEMY — Compact brand/value editorial section
         ================================================================ -->
    <section class="studio-why academy-section" aria-labelledby="why-heading" data-academy-section="why">
      <!-- Editorial blueprint artwork + parallax -->
      <div class="studio-why__bg-artwork" aria-hidden="true">
        <svg class="studio-why__svg-grid" viewBox="0 0 1000 400" fill="none" preserveAspectRatio="none" data-parallax="0.05">
          <line x1="0" y1="100" x2="1000" y2="100" stroke="rgba(212, 212, 212, 0.04)" stroke-width="1" />
          <line x1="0" y1="200" x2="1000" y2="200" stroke="rgba(212, 212, 212, 0.04)" stroke-width="1" />
          <line x1="0" y1="300" x2="1000" y2="300" stroke="rgba(212, 212, 212, 0.04)" stroke-width="1" />
          <line x1="300" y1="0" x2="300" y2="400" stroke="rgba(212, 212, 212, 0.04)" stroke-width="1" />
          <line x1="700" y1="0" x2="700" y2="400" stroke="rgba(212, 212, 212, 0.04)" stroke-width="1" />
        </svg>
        <div class="studio-why__blueprint" data-parallax="0.1" aria-hidden="true">
          <AcademyBlueprint />
        </div>
      </div>

      <Container>
        <div class="studio-why__grid">
          <div class="studio-why__left reveal-fade-up">
            <span class="studio-eyebrow">WHY ROBODEV ACADEMY</span>
            <h2 class="studio-why__title" id="why-heading">
              Learn from builders.
            </h2>
            <p class="studio-why__lead">
              RoboDev Academy is taught directly by engineers who actively build and deploy software at RoboDev Labs. We teach the workflows we rely on ourselves.
            </p>
          </div>

          <div class="studio-why__right reveal-fade-up">
            <div class="studio-value-block">
              <h3 class="studio-value-title">Practical learning</h3>
              <p class="studio-value-desc">
                No artificial toy problems or high-level slide lectures. You work directly on architectures, tools, and code structures identical to actual development sprints.
              </p>
            </div>

            <div class="studio-value-block">
              <h3 class="studio-value-title">Direct guidance</h3>
              <p class="studio-value-desc">
                Interactive sessions where you can ask specific questions, troubleshoot roadblocks, and understand why certain trade-offs are chosen in live systems.
              </p>
            </div>

            <div class="studio-value-block">
              <h3 class="studio-value-title">Current tools and workflows</h3>
              <p class="studio-value-desc">
                We continuously refresh our curriculums so you practise with modern frameworks, automation APIs, and Figma design systems currently valued in technology careers.
              </p>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <div class="studio-divider"><Container><hr /></Container></div>

    <!-- ================================================================
         6. HOW IT WORKS — Compact, restrained 3-step sequence
         ================================================================ -->
    <section class="studio-steps academy-section" id="how-it-works" aria-labelledby="how-heading" data-academy-section="steps">
      <Container>
        <div class="studio-steps__header reveal-fade-up">
          <span class="studio-eyebrow">PROCESS</span>
          <h2 class="studio-steps__title" id="how-heading">How it works</h2>
        </div>

        <div class="studio-steps__wrapper reveal-fade-up">
          <!-- Visual progression path: Choose → Build → Keep building -->
          <AcademyPath class="studio-steps__path" />
