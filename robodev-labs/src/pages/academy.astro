<style>
  /* =========================================================================
     RoboDev Academy — Editorial Workshop Studio
     Color Palette:
       --color-pepper-dark:   #7C8363
       --color-pepper-medium: #31473A
       --color-salt-white:    #EDF4F2
       --color-salt-light:    #D4D4D4
     ========================================================================= */

  .studio-page {
    background-color: var(--color-pepper-dark, #7C8363);
    color: var(--color-salt-white, #EDF4F2);
    min-height: 100vh;
  }

  /* ── Shared Eyebrow & Typographic Utilities ── */
  .studio-eyebrow {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-salt-light, #D4D4D4);
  }

  .studio-micro-heading {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(237, 244, 242, 0.7);
    margin: 0 0 0.75rem;
  }

  .studio-text-link {
    font-size: 0.9375rem;
    color: var(--color-salt-white, #EDF4F2);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(212, 212, 212, 0.4);
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  .studio-text-link:hover {
    color: #ffffff;
    text-decoration-color: #ffffff;
  }

  .studio-divider {
    padding: 0;
  }

  .studio-divider hr {
    border: none;
    border-top: 1px solid rgba(212, 212, 212, 0.16);
    margin: 0;
  }

  .studio-arrow {
    display: inline-block;
    transition: transform 160ms ease;
  }

  /* ── Motion & Reveal System ── */
  .reveal-fade-up {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .reveal-fade-up.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-fade-up {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* =========================================================================
     1. HERO
     ========================================================================= */
  .studio-hero {
    position: relative;
    background-color: var(--color-pepper-medium, #31473A);
    padding-top: clamp(6.5rem, 13vh, 9.5rem);
    padding-bottom: clamp(4.5rem, 9vh, 7rem);
    border-bottom: 1px solid rgba(212, 212, 212, 0.15);
    overflow: hidden;
  }

  .studio-hero__backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .studio-hero__glow {
    position: absolute;
    top: -15%;
    right: -10%;
    width: 650px;
    height: 650px;
    background: radial-gradient(circle, rgba(181, 213, 173, 0.12) 0%, rgba(49, 71, 58, 0) 70%);
    filter: blur(40px);
  }

  .studio-hero__blueprint-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(212, 212, 212, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212, 212, 212, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at 75% 35%, black 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at 75% 35%, black 20%, transparent 80%);
  }

  .studio-hero__geometry {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .studio-hero__geometry--back {
    opacity: 0.8;
  }

  .studio-hero__geometry--front {
    opacity: 0.95;
  }

  .studio-hero__inner {
