---
import Container from '../ui/Container.astro';
import Logo from '../common/Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import { siteConfig } from '../../config/site';

const currentYear = new Date().getFullYear();

const socialsList = [
  { name: 'GitHub', icon: 'github', url: siteConfig.socials.github },
  { name: 'LinkedIn', icon: 'linkedin', url: siteConfig.socials.linkedin },
  { name: 'Instagram', icon: 'instagram', url: siteConfig.socials.instagram },
  { name: 'YouTube', icon: 'youtube', url: siteConfig.socials.youtube },
  { name: 'X', icon: 'twitter', url: siteConfig.socials.x },
];
---

<div id="contact" class="continuous-footer-wrapper">
  <!-- Ambient Atmospheric Back-Glow -->
  <div class="ambient-glow-layer" aria-hidden="true">
    <div class="glow-radial-orb"></div>
  </div>

  <!-- =========================================================================
       1. HIGH-IMPACT PREMIUM CTA SECTION
       ========================================================================= -->
  <section class="cta-section" aria-labelledby="cta-heading">
    <Container class="cta-inner-container">
      <div class="cta-main-layout">
        <!-- Left / Primary Content Column -->
        <div class="cta-content-col">
          <!-- Display Title -->
          <h2 id="cta-heading" class="cta-headline">
            Have an idea worth <br class="title-break" />
            <span class="cta-highlight-gradient">building into reality?</span>
          </h2>

          <!-- Descriptive Subtitle -->
          <p class="cta-subtext">
            Let's turn your vision into high-impact software. Whether you require custom engineering, proprietary product acceleration, or technical education — we are here to build.
          </p>

          <!-- Dual Action Buttons -->
          <div class="cta-button-group">
            <Button
              variant="primary"
              size="md"
              href={`mailto:${siteConfig.email}?subject=Project%20Inquiry%20-%20RoboDev%20Labs`}
            >
              <span>Start a conversation</span>
              <span aria-hidden="true">&rarr;</span>
            </Button>

            <Button variant="secondary" size="md" href="#services">
              <span>Explore capabilities</span>
            </Button>
          </div>

          <!-- Trust & Response Time Micro-Pills -->
          <div class="cta-trust-strip">
            <div class="trust-item">
              <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>Response within 24 hours</span>
            </div>
            <span class="trust-dot-sep">&bull;</span>
            <div class="trust-item">
              <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>Direct engineer access</span>
            </div>
            <span class="trust-dot-sep">&bull;</span>
            <div class="trust-item">
              <svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              <span>Production-grade engineering</span>
            </div>
          </div>
        </div>

        <!-- Right / Highlight Cards Column -->
        <div class="cta-card-col">
          <div class="cta-preview-card">
            <div class="card-glow-edge"></div>
            <div class="preview-header">
              <span class="preview-tag">ROBODEV ECOSYSTEM</span>
              <span class="preview-status">Active Operations</span>
            </div>

            <div class="preview-items-list">
              <a href="#services" class="preview-item">
                <div class="item-icon-box">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                </div>
                <div class="item-details">
                  <span class="item-title">Engineering Services</span>
                  <span class="item-desc">Custom web, mobile, cloud & AI systems</span>
                </div>
                <span class="item-action-arrow">&rarr;</span>
              </a>

              <a href="#products" class="preview-item">
                <div class="item-icon-box">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                  </svg>
                </div>
                <div class="item-details">
                  <span class="item-title">Busly Transit Engine</span>
                  <span class="item-desc">Live public transit tracking platform</span>
                </div>
                <span class="item-action-arrow">&rarr;</span>
              </a>

              <a href="#academy" class="preview-item">
                <div class="item-icon-box">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                  </svg>
                </div>
                <div class="item-details">
                  <span class="item-title">RoboDev Academy</span>
                  <span class="item-desc">High-impact engineering fellowships</span>
                </div>
                <span class="item-action-arrow">&rarr;</span>
              </a>
            </div>

            <div class="preview-footer-contact">
              <span class="direct-label">Direct Reach:</span>
              <a href={`mailto:${siteConfig.email}`} class="direct-email-link">
                {siteConfig.email}
              </a>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- =========================================================================
       HORIZON TRANSITION SEAM (Luminous Boundary with Beacon Pulse)
       ========================================================================= -->
  <div class="horizon-seam-container" aria-hidden="true">
    <svg 
      class="horizon-seam-svg" 
      viewBox="0 0 1440 90" 
      fill="none" 
      xmlns="http://www.w3.org/2000/svg"
      preserveAspectRatio="none"
    >
      <defs>
        <linearGradient id="seamHorizonGlow" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#0284c7" stop-opacity="0.05" />
          <stop offset="25%" stop-color="#06b6d4" stop-opacity="0.5" />
          <stop offset="65%" stop-color="#38bdf8" stop-opacity="0.95" />
          <stop offset="85%" stop-color="#2563eb" stop-opacity="0.55" />
          <stop offset="100%" stop-color="#0284c7" stop-opacity="0.05" />
        </linearGradient>
        <linearGradient id="seamFillGlow" x1="50%" y1="0%" x2="50%" y2="100%">
          <stop offset="0%" stop-color="#06b6d4" stop-opacity="0.08" />
          <stop offset="100%" stop-color="#050811" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Soft Area Glow -->
      <path 
        d="M 0 52 C 340 32, 680 75, 1020 35 C 1220 12, 1360 30, 1440 32 L 1440 90 L 0 90 Z" 
        fill="url(#seamFillGlow)" 
      />

      <!-- Wave Glow (Soft Blur) -->
      <path 
        d="M 0 52 C 340 32, 680 75, 1020 35 C 1220 12, 1360 30, 1440 32" 
        stroke="url(#seamHorizonGlow)" 
        stroke-width="5" 
        opacity="0.45" 
        class="wave-blur"
      />

      <!-- Wave Line (Crisp) -->
      <path 
        d="M 0 52 C 340 32, 680 75, 1020 35 C 1220 12, 1360 30, 1440 32" 
        stroke="url(#seamHorizonGlow)" 
        stroke-width="1.8" 
        stroke-linecap="round"
      />

      <!-- Subtle Dashed Accent Arc -->
      <path 
        d="M 760 0 C 820 15, 920 28, 1020 35 C 1140 42, 1300 55, 1440 32" 
        stroke="url(#seamHorizonGlow)" 
        stroke-width="1.2" 
        stroke-dasharray="3 3"
        opacity="0.35"
      />
    </svg>
  </div>

  <!-- =========================================================================
       2. STRUCTURED PROFESSIONAL FOOTER SECTION
       ========================================================================= -->
  <footer class="footer-main" role="contentinfo">
    <Container class="footer-inner-container">
      <!-- Top Grid: 4 Clean, Well-Organized Columns -->
      <div class="footer-structured-grid">
        <!-- Col 1: Brand & Identity -->
        <div class="footer-block brand-block">
          <div class="brand-logo-wrap">
            <Logo height={32} />
          </div>
          <p class="brand-mission-summary">
            A premier engineering lab and developer academy based in Nepal. We architect enduring software, develop proprietary ventures, and mentor top-tier engineering talent.
          </p>

          <!-- Active Presence Indicator -->
          <div class="location-status-badge">
            <span class="live-dot"></span>
            <span class="badge-label">Kathmandu, Nepal &bull; Global Delivery</span>
          </div>

          <!-- Social Links Row -->
          <div class="footer-social-row">
            {socialsList.map((item) => (
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="social-pill-btn"
                title={`RoboDev Labs on ${item.name}`}
                aria-label={item.name}
              >
                <Icon name={item.icon as any} size={15} />
              </a>
            ))}
          </div>
        </div>

        <!-- Col 2: Ecosystem & Solutions -->
        <div class="footer-block">
          <h3 class="footer-col-heading">ECOSYSTEM</h3>
          <ul class="footer-link-list">
            <li><a href="#services" class="footer-nav-link">Custom Software & Cloud</a></li>
            <li><a href="#services" class="footer-nav-link">AI & Intelligent Systems</a></li>
            <li><a href="#products" class="footer-nav-link">Product Studio</a></li>
            <li><a href="#products" class="footer-nav-link">Busly Transit Platform</a></li>
            <li><a href="#academy" class="footer-nav-link">RoboDev Academy</a></li>
            <li><a href="#process" class="footer-nav-link">Engineering Lifecycle</a></li>
          </ul>
        </div>

        <!-- Col 3: Company & Culture -->
        <div class="footer-block">
          <h3 class="footer-col-heading">COMPANY</h3>
          <ul class="footer-link-list">
            <li><a href="#leadership" class="footer-nav-link">Founders & Leadership</a></li>
            <li><a href="#pillars" class="footer-nav-link">Company Ecosystem</a></li>
            <li><a href="#process" class="footer-nav-link">How We Work</a></li>
            <li><a href={`mailto:${siteConfig.email}?subject=Career%20Inquiry%20-%20RoboDev%20Labs`} class="footer-nav-link">Careers & Fellowships</a></li>
            <li><a href={`mailto:${siteConfig.email}?subject=Media%20Inquiry`} class="footer-nav-link">Press & Media</a></li>
          </ul>
        </div>

        <!-- Col 4: Action & Direct Connection -->
        <div class="footer-block contact-block">
          <h3 class="footer-col-heading">CONNECT</h3>
          <p class="connect-helper-text">
            Ready to partner on a mission-critical project or join our academy cohort?
          </p>
          <ul class="footer-action-list">
            <li>
              <a href={`mailto:${siteConfig.email}?subject=Start%20a%20Project`} class="action-card-link primary-action">
                <div class="action-info">
                  <span class="action-title">Start a Project</span>
                  <span class="action-sub">Scope your build with us</span>
                </div>
                <span class="action-arrow">&rarr;</span>
              </a>
            </li>
            <li>
              <a href="#academy" class="action-card-link">
                <div class="action-info">
                  <span class="action-title">Learn with Us</span>
                  <span class="action-sub">Explore Academy programs</span>
                </div>
                <span class="action-arrow">&rarr;</span>
              </a>
            </li>
          </ul>
          <div class="quick-email-display">
            <span class="email-caption">General Inquiries</span>
            <a href={`mailto:${siteConfig.email}`} class="direct-email-text">
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Bar: Legal, Rights, & Security -->
      <div class="footer-bottom-strip">
        <div class="bottom-left-legal">
          <span class="copyright-text">&copy; {currentYear} {siteConfig.name}. All rights reserved.</span>
        </div>

        <div class="bottom-center-links">
          <a href="#" class="legal-nav-link">Privacy Policy</a>
          <span class="legal-sep">&bull;</span>
          <a href="#" class="legal-nav-link">Terms of Service</a>
          <span class="legal-sep">&bull;</span>
          <a href="#" class="legal-nav-link">Security</a>
        </div>

        <div class="bottom-right-meta">
          <span class="craft-badge">Crafted with engineering discipline</span>
        </div>
      </div>
    </Container>
  </footer>
</div>

<style>
  /* ==========================================================================
     CONTINUOUS CTA & FOOTER WRAPPER
     Professional, calm, technologically sophisticated, 100% responsive.
     ========================================================================== */
  .continuous-footer-wrapper {
    position: relative;
    background-color: #050811;
    overflow-x: hidden;
    isolation: isolate;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* --------------------------------------------------------------------------
     Ambient Atmosphere
     -------------------------------------------------------------------------- */
  .ambient-glow-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .glow-radial-orb {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(350px, 70vw, 900px);
    height: clamp(200px, 30vw, 400px);
    background: radial-gradient(ellipse at center, rgba(6, 182, 212, 0.12) 0%, rgba(30, 64, 175, 0.05) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* --------------------------------------------------------------------------
     Horizon Seam Separator
     -------------------------------------------------------------------------- */
  .horizon-seam-container {
    position: relative;
    width: 100%;
    height: clamp(50px, 6vw, 85px);
    margin-top: -10px;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .horizon-seam-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .wave-blur {
    filter: blur(4px);
  }

  /* --------------------------------------------------------------------------
     1. CTA Stage
     -------------------------------------------------------------------------- */
  .cta-section {
    position: relative;
    z-index: 2;
    padding-top: clamp(4rem, 7.5vw, 6.5rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .cta-inner-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
  }

  .cta-main-layout {
    display: grid;
    grid-template-columns: 1.18fr 0.82fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  /* Left Column */
  .cta-content-col {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.4rem);
  }

  .cta-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.2rem;
  }

  .cta-headline {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: #f8fafc;
    margin: 0;
  }

  .title-break {
    display: block;
  }

  .cta-highlight-gradient {
    color: #38bdf8;
    background: linear-gradient(135deg, #38bdf8 0%, #06b6d4 50%, #60a5fa 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cta-subtext {
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
    color: #94a3b8;
    line-height: 1.65;
    margin: 0;
    max-width: 580px;
  }

  /* Dual Action Buttons */
  .cta-button-group {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }



  /* Trust Indicators Strip */
  .cta-trust-strip {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
    margin-top: 0.25rem;
  }

  .trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #64748b;
  }

  .trust-icon {
    width: 13px;
    height: 13px;
    color: #06b6d4;
  }

  .trust-dot-sep {
    color: #334155;
    font-size: 0.75rem;
  }

  /* Right Column: Interactive Ecosystem Card */
  .cta-card-col {
    display: flex;
    justify-content: center;
  }

  .cta-preview-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.7) 0%, rgba(10, 15, 29, 0.85) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    backdrop-filter: blur(16px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .card-glow-edge {
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #38bdf8, transparent);
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .preview-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: #94a3b8;
    text-transform: uppercase;
  }

  .preview-status {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #06b6d4;
  }

  .preview-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .preview-item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.75rem 0.9rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .preview-item:hover {
    background: rgba(6, 182, 212, 0.06);
    border-color: rgba(6, 182, 212, 0.2);
    transform: translateX(3px);
  }

  .item-icon-box {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(56, 189, 248, 0.1);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .item-icon-box svg {
    width: 16px;
    height: 16px;
  }

  .item-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .item-title {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .item-desc {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: #64748b;
  }

  .item-action-arrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #475569;
    transition: all 0.2s ease;
  }

  .preview-item:hover .item-action-arrow {
    color: #38bdf8;
    transform: translateX(2px);
  }

  .preview-footer-contact {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.76rem;
  }

  .direct-label {
    font-family: var(--font-sans);
    color: #64748b;
  }

  .direct-email-link {
    font-family: var(--font-mono);
    color: #38bdf8;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .direct-email-link:hover {
    color: #06b6d4;
    text-decoration: underline;
  }

  /* --------------------------------------------------------------------------
     2. Structured Professional Footer
     -------------------------------------------------------------------------- */
  .footer-main {
    position: relative;
    z-index: 2;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    background: rgba(5, 8, 17, 0.95);
  }

  .footer-inner-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
  }

  /* 4-Column Structured Grid */
  .footer-structured-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.9fr 0.95fr 1.15fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .footer-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Brand Block */
  .brand-logo-wrap {
    display: flex;
    align-items: center;
  }

  .brand-mission-summary {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
    max-width: 320px;
  }

  .location-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #64748b;
    margin-top: 0.25rem;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 6px rgba(16, 185, 129, 0.8);
  }

  .footer-social-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .social-pill-btn {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .social-pill-btn:hover {
    color: #ffffff;
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.35);
    transform: translateY(-2px);
  }

  /* Nav Columns */
  .footer-col-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #64748b;
    font-weight: 600;
    margin: 0;
  }

  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
