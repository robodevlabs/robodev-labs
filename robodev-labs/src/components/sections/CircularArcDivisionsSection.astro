      <button class="scroll-next-btn" id="scroll-next-trigger" aria-label="Advance to Next Section">
        <span class="scroll-next-caption">SCROLL TO NEXT</span>
        <span class="scroll-next-dash"></span>
        <div class="scroll-arrow-circle">
          <Icon name="arrow-down" size={14} />
