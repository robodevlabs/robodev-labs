            </div>

            <div class="iso-floating-badge deployed-badge">
              <div class="badge-icon-cloud purple">
                <Icon name="users" size={16} />
              </div>
              <div class="badge-text-cluster">
                <span class="badge-status-line">
                  <span>Mentorship</span>
                  <span class="badge-live-dot purple"></span>
                </span>
