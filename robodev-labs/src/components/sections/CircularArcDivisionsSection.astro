---
/**
 * CircularArcDivisionsSection.astro
 * 
 * Signature Circular Arc Division Showcase matching the reference design:
 * - SINGLE, continuous, full-height architectural circle arc glowing in rich cyan/blue gradient.
 * - Starts from the VERY LEFT edge of the screen (viewport left: 0).
 * - Nodes positioned via true circular trigonometry along the single arc line.
 * - Strictly 3 menu nodes (01 Engineering, 02 Products, 03 Academy) spread generously apart.
 * - ZERO OVERLAP: Content stage strictly positioned with ample clear gutter.
 * - CURVED CLOCK MOTION: Editorial component texts move along a curved arc trajectory matching the circular arch!
 * - Reversible in both scroll directions.
 * - Bottom-right "SCROLL TO NEXT ——————— (↓)" action.
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
---

<div class="circular-arc-scroll-realm" id="circular-arc-scroll-realm">
  <!-- Navigation Anchor Targets -->
  <div id="services" class="section-anchor-marker" style="position: absolute; top: 0; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none;"></div>
  <div id="products" class="section-anchor-marker" style="position: absolute; top: 33%; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none;"></div>
  <div id="academy" class="section-anchor-marker" style="position: absolute; top: 66%; left: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none;"></div>
  
  <!-- Pinned 100vh Sticky Viewport Stage spanning full viewport -->
  <section class="circular-arc-sticky-stage" id="ecosystem-divisions" aria-label="RoboDev Labs Core Divisions">
    
    <!-- Atmospheric Background Ambient Canvas -->
    <div class="circular-backdrop" aria-hidden="true">
      <div class="ambient-glow glow-blue"></div>
      <div class="ambient-glow glow-cyan"></div>
      <div class="grid-dust-overlay"></div>
    </div>

    <!-- =========================================================================
         LEFT: SINGLE FULL-HEIGHT ARCHITECTURAL CIRCLE ARC & ORBITING NODES
         Starts at very top-left (0,0), curves outwards to apex (240px), and finishes at (0, 100% height)
         ========================================================================= -->
    <aside class="arc-navigation-system" id="arc-nav-system" aria-label="Division Arc Dial">
      <!-- Full-Height SVG Vector Canvas with Single Glowing Arc -->
      <svg class="arc-full-svg" id="arc-full-svg" viewBox="0 0 360 1000" preserveAspectRatio="none" aria-hidden="true">
        <!-- Single Continuous Arc Line with Vibrant Cyan/Blue Gradient and Neon Glow -->
        <path 
          id="base-full-arc" 
          d="M 0,0 C 340,240 340,760 0,1000" 
          fill="none" 
          stroke="url(#cyanGlowGrad)" 
          stroke-width="2.2"
          filter="url(#neonFilter)"
        />
        
        <defs>
          <linearGradient id="cyanGlowGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#2B2B2B" stop-opacity="0.3" />
            <stop offset="25%" stop-color="#D4D4D4" stop-opacity="0.9" />
            <stop offset="50%" stop-color="#FFFFFF" stop-opacity="1" />
            <stop offset="75%" stop-color="#D4D4D4" stop-opacity="0.9" />
            <stop offset="100%" stop-color="#2B2B2B" stop-opacity="0.3" />
          </linearGradient>
          <filter id="neonFilter" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="3.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>
      </svg>

      <!-- Mathematically Positioned Nodes Along the Arc Line (Strictly 3 Menu Items) -->
      <div class="arc-nodes-orbit" id="arc-nodes-orbit">
        
        <!-- Node 01: Engineering -->
        <button 
          class="arc-node-element active" 
          id="node-btn-0" 
          data-index="0" 
          role="tab" 
          aria-selected="true" 
          aria-controls="content-panel-0"
        >
          <div class="node-bullet-target">
            <span class="outer-glow-ring"></span>
            <span class="center-core-dot"></span>
          </div>
          <div class="node-text-lockup">
            <span class="node-seq">01</span>
            <span class="node-title">Engineering</span>
          </div>
        </button>

        <!-- Node 02: Products -->
        <button 
          class="arc-node-element" 
          id="node-btn-1" 
          data-index="1" 
          role="tab" 
          aria-selected="false" 
          aria-controls="content-panel-1"
        >
          <div class="node-bullet-target">
            <span class="outer-glow-ring"></span>
            <span class="center-core-dot"></span>
          </div>
          <div class="node-text-lockup">
            <span class="node-seq">02</span>
            <span class="node-title">Products</span>
          </div>
        </button>

        <!-- Node 03: Academy -->
        <button 
          class="arc-node-element" 
          id="node-btn-2" 
          data-index="2" 
          role="tab" 
          aria-selected="false" 
          aria-controls="content-panel-2"
        >
          <div class="node-bullet-target">
            <span class="outer-glow-ring"></span>
            <span class="center-core-dot"></span>
          </div>
          <div class="node-text-lockup">
            <span class="node-seq">03</span>
            <span class="node-title">Academy</span>
          </div>
        </button>

      </div>
    </aside>

    <!-- =========================================================================
         CENTER: EDITORIAL CONTENT CLOCK-VIEWPORT
         Safe horizontal clearance (left: clamp(450px, 31vw, 550px)) guarantees ZERO overlap!
         Texts slide along a curved arc trajectory matching the circular arch.
         ========================================================================= -->
    <div class="division-narrative-stage">
      <div class="editorial-clock-track">
        
        <!-- PANEL 0: ENGINEERING -->
        <article 
          class="division-editorial-panel active" 
          id="content-panel-0" 
          role="tabpanel" 
          aria-labelledby="node-btn-0"
        >
          <header class="editorial-header">
            <h2 class="editorial-main-title">
              Engineering<br />Services
            </h2>
            <p class="editorial-lead">
              We build scalable, high-performance software solutions that help businesses grow, innovate, and stay ahead.
            </p>
          </header>

          <!-- 2-Column Clean Capabilities Grid with Minimal SVG Icons -->
          <div class="capabilities-dual-grid">
            <div class="cap-col">
              <div class="cap-item">
                <span class="cap-ico"><Icon name="code" size={17} /></span>
                <span class="cap-txt">Web Applications</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="smartphone" size={17} /></span>
                <span class="cap-txt">Mobile Applications</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="cloud" size={17} /></span>
                <span class="cap-txt">SaaS Development</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="database" size={17} /></span>
                <span class="cap-txt">Backend Development</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="link" size={17} /></span>
                <span class="cap-txt">API Development</span>
              </div>
            </div>

            <div class="cap-col">
              <div class="cap-item">
                <span class="cap-ico"><Icon name="cpu" size={17} /></span>
                <span class="cap-txt">AI Solutions</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="cloud" size={17} /></span>
                <span class="cap-txt">Cloud Solutions</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="layers" size={17} /></span>
                <span class="cap-txt">UI/UX Implementation</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="users" size={17} /></span>
                <span class="cap-txt">Software Consulting</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="sparkles" size={17} /></span>
                <span class="cap-txt">Automation &amp; Integrations</span>
              </div>
            </div>
          </div>

          <div class="editorial-action-row">
            <Button variant="primary" size="md" href="/services" class="academy-explore-btn">
              <span>Explore our services</span>
              <Icon name="arrow-right" size={15} />
            </Button>
          </div>
        </article>

        <!-- PANEL 1: PRODUCTS -->
        <article 
          class="division-editorial-panel future" 
          id="content-panel-1" 
          role="tabpanel" 
          aria-labelledby="node-btn-1"
        >
          <header class="editorial-header">
            <h2 class="editorial-main-title">
              Proprietary<br />Products
            </h2>
            <p class="editorial-lead">
              We engineer our own technology ventures. Our flagship product, <strong>Busly</strong>, transforms public transit uncertainty into reliable, live-tracked mobility.
            </p>
          </header>

          <div class="capabilities-dual-grid">
            <div class="cap-col">
              <div class="cap-item">
                <span class="cap-ico"><Icon name="zap" size={17} /></span>
                <span class="cap-txt">Busly Mobility OS</span>
