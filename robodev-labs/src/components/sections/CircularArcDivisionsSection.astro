              <div class="cap-item">
                <span class="cap-ico"><Icon name="sparkles" size={17} /></span>
                <span class="cap-txt">Live GPS Fleet Telemetry</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="layers" size={17} /></span>
                <span class="cap-txt">Route Arrival Prediction</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="smartphone" size={17} /></span>
                <span class="cap-txt">Offline-First Commuter App</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="database" size={17} /></span>
                <span class="cap-txt">Transit Operator Console</span>
              </div>
            </div>

            <div class="cap-col">
              <div class="cap-item">
                <span class="cap-ico"><Icon name="cpu" size={17} /></span>
                <span class="cap-txt">Autonomous Dispatch Tools</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="cloud" size={17} /></span>
                <span class="cap-txt">Edge Telemetry Relays</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="code" size={17} /></span>
                <span class="cap-txt">Developer Acceleration SDKs</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="link" size={17} /></span>
                <span class="cap-txt">Multi-Modal Transit APIs</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="users" size={17} /></span>
                <span class="cap-txt">Scalable Venture Pipeline</span>
              </div>
            </div>
          </div>

          <div class="editorial-action-row">
            <Button variant="primary" size="md" href="/products" class="academy-explore-btn">
              <span>Explore our Product</span>
              <Icon name="arrow-right" size={15} />
            </Button>
          </div>
        </article>

        <!-- PANEL 2: ACADEMY -->
        <article 
          class="division-editorial-panel future" 
          id="content-panel-2" 
          role="tabpanel" 
          aria-labelledby="node-btn-2"
        >
          <header class="editorial-header">
            <h2 class="editorial-main-title">
              Developer<br />Academy
            </h2>
            <p class="editorial-lead">
              We bridge the gap between academic theory and real-world software through intensive engineering workshops, project mentorship, and production hackathons.
            </p>
          </header>

          <div class="capabilities-dual-grid">
            <div class="cap-col">
              <div class="cap-item">
                <span class="cap-ico"><Icon name="code" size={17} /></span>
                <span class="cap-txt">Hands-On Code Workshops</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="users" size={17} /></span>
                <span class="cap-txt">1-on-1 Senior Mentorship</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="layers" size={17} /></span>
                <span class="cap-txt">Production PR &amp; Code Reviews</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="database" size={17} /></span>
                <span class="cap-txt">System Architecture Coaching</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="link" size={17} /></span>
                <span class="cap-txt">CI/CD &amp; Git Best Practices</span>
              </div>
            </div>

            <div class="cap-col">
              <div class="cap-item">
                <span class="cap-ico"><Icon name="zap" size={17} /></span>
                <span class="cap-txt">Competitive Hackathon Prep</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="cpu" size={17} /></span>
                <span class="cap-txt">Practical AI API Integration</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="smartphone" size={17} /></span>
                <span class="cap-txt">MVP Prototyping in 48 Hours</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="cloud" size={17} /></span>
                <span class="cap-txt">Live Cloud Deployment</span>
              </div>
              <div class="cap-item">
                <span class="cap-ico"><Icon name="sparkles" size={17} /></span>
                <span class="cap-txt">Engineering Career Guidance</span>
              </div>
            </div>
          </div>

          <div class="editorial-action-row">
            <Button variant="primary" size="md" href="/academy" class="academy-explore-btn">
              <span>Explore Academy Programs</span>
              <Icon name="arrow-right" size={15} />
            </Button>
          </div>
        </article>

      </div>
    </div>

    <!-- =========================================================================
         RIGHT: ISOMETRIC 3D FLOATING GLASS TECH COMPOSITION
         Transitions with matching curved vertical motion
         ========================================================================= -->
    <div class="isometric-visual-stage" aria-hidden="true">
      <div class="iso-visual-clock-track">
        
        <!-- VISUAL 0: ENGINEERING ISOMETRIC IDE & PERFORMANCE -->
        <div class="iso-composition-scene active" id="iso-scene-0">
          <div class="iso-perspective-box">
            
            <!-- Floating Background Glass IDE Window -->
            <div class="iso-glass-window ide-window">
              <div class="ide-window-topbar">
                <div class="ide-traffic-lights">
                  <span class="tl-dot red"></span>
                  <span class="tl-dot yellow"></span>
                  <span class="tl-dot green"></span>
                </div>
                <div class="ide-title-tab">robodev://services.ts</div>
                <div class="ide-tag-badge">RELEASED</div>
              </div>

              <div class="ide-window-body">
                <div class="ide-file-tree">
                  <span class="tree-line active"></span>
                  <span class="tree-line"></span>
                  <span class="tree-line"></span>
                  <span class="tree-line"></span>
                  <span class="tree-line"></span>
                  <span class="tree-line"></span>
                </div>

                <div class="ide-code-lines">
                  <div class="code-row"><span class="syn-k">import</span> <span class="syn-v">&#123; createArchitecture &#125;</span> <span class="syn-k">from</span> <span class="syn-s">'@robodev/core'</span>;</div>
                  <div class="code-row"><span class="syn-c">// High-throughput enterprise solution</span></div>
                  <div class="code-row"><span class="syn-k">export const</span> <span class="syn-f">servicePipeline</span> = <span class="syn-k">async</span> () =&gt; &#123;</div>
                  <div class="code-row ind-1"><span class="syn-k">const</span> system = <span class="syn-k">await</span> <span class="syn-f">initializeCluster</span>(&#123;</div>
                  <div class="code-row ind-2">concurrency: <span class="syn-n">100000</span>,</div>
                  <div class="code-row ind-2">latency: <span class="syn-s">'sub-10ms'</span>,</div>
                  <div class="code-row ind-2">resilience: <span class="syn-b">true</span></div>
                  <div class="code-row ind-1">&#125;);</div>
                  <div class="code-row ind-1"><span class="syn-k">return</span> system.<span class="syn-f">deploy</span>();</div>
                  <div class="code-row">&#125;;</div>
                </div>
              </div>
            </div>

            <!-- Foreground Floating Glass Card: Performance Graph Spline -->
            <div class="iso-floating-card performance-card">
              <div class="perf-card-header">
                <span class="perf-status-beacon"></span>
                <span class="perf-label">Performance</span>
              </div>
              <div class="perf-chart-wrap">
                <svg viewBox="0 0 200 70" class="perf-spline-svg" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="chartLineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#B3B3B3" />
                      <stop offset="50%" stop-color="#D4D4D4" />
                      <stop offset="100%" stop-color="#FFFFFF" />
                    </linearGradient>
                    <linearGradient id="chartAreaGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="rgba(255, 255, 255, 0.2)" />
                      <stop offset="100%" stop-color="rgba(255, 255, 255, 0)" />
                    </linearGradient>
                  </defs>
                  <path d="M 0 50 Q 40 55, 70 30 T 140 20 T 200 10 L 200 70 L 0 70 Z" fill="url(#chartAreaGrad)" />
                  <path d="M 0 50 Q 40 55, 70 30 T 140 20 T 200 10" fill="none" stroke="url(#chartLineGrad)" stroke-width="2.5" />
                  <circle cx="200" cy="10" r="3.5" fill="#FFFFFF" filter="drop-shadow(0 0 6px rgba(255, 255, 255, 0.8))" />
                </svg>
              </div>
            </div>

            <!-- Foreground Floating Badge: Deployed • -->
            <div class="iso-floating-badge deployed-badge">
              <div class="badge-icon-cloud">
                <Icon name="cloud" size={16} />
              </div>
              <div class="badge-text-cluster">
                <span class="badge-status-line">
                  <span>Deployed</span>
                  <span class="badge-live-dot"></span>
                </span>
              </div>
            </div>

            <!-- Constellation Micro-nodes -->
            <div class="iso-wire-constellation">
              <span class="const-node c-1"></span>
              <span class="const-node c-2"></span>
              <span class="const-node c-3"></span>
            </div>

          </div>
        </div>

        <!-- VISUAL 1: PRODUCTS ISOMETRIC BUSLY TRANSIT ENGINE -->
        <div class="iso-composition-scene future" id="iso-scene-1">
          <div class="iso-perspective-box">
            
            <div class="iso-glass-window busly-window">
