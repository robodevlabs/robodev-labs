</div>

<script>
  /**
   * Signature Circular Arc Geometry & Curved Motion Clock Controller
   * - SINGLE Arc path: starts at (x: 0, y: 0) and finishes at (x: 0, y: H)
   * - Peak apex of arc is at x = X_MAX (approx 240px) at vertical center (y = H/2)
   * - Nodes move along the parabolic curve: x(y) = X_MAX * (1 - ((y - H/2)/(H/2))^2)
   * - Generously spread out node spacing (NODE_SPACING = 340px)
   * - Strictly 3 menu nodes (01 Engineering, 02 Products, 03 Academy)
   * - Editorial content slides along a CURVED trajectory matching the circular arc!
   */
  function initCircularArcSection() {
    const realm = document.getElementById('circular-arc-scroll-realm');
    const stage = document.getElementById('ecosystem-divisions');
    const nodes = document.querySelectorAll<HTMLButtonElement>('.arc-node-element');
    const panels = document.querySelectorAll<HTMLElement>('.division-editorial-panel');
    const scenes = document.querySelectorAll<HTMLElement>('.iso-composition-scene');
    const scrollNextBtn = document.getElementById('scroll-next-trigger');

    if (!realm || !stage || !nodes.length || !panels.length) return;

    let activeIndex = 0;
    const X_MAX = 240;        // Apex X coordinate in pixels from left edge
    const NODE_SPACING = 340; // Generously spread out menu node spacing along arc

    function isMobileView(): boolean {
      return window.innerWidth <= 768;
    }

    // Mathematical Parabolic/Circle Curve Function
    function getArcX(y: number, H: number): number {
      const u = (y - H / 2) / (H / 2);
      const clampedU = Math.max(-1, Math.min(1, u));
      return Math.max(0, X_MAX * (1 - clampedU * clampedU));
    }

    // Update positions and active visual states based on scroll progress (0.0 to 1.0)
    function updateArcGeometry(progress: number) {
      if (isMobileView()) {
        // On mobile, nodes are in a clean top horizontal segment bar. Do NOT apply 3D transforms.
        return;
      }

      const H = stage?.clientHeight || window.innerHeight;
      const centerY = H / 2;

      // Scroll offset moves nodes along the arc curve
      const totalStages = 2; // 0 to 2
      const scrollOffset = progress * totalStages * NODE_SPACING;

      nodes.forEach((node, i) => {
        const nodeY = centerY + (i * NODE_SPACING) - scrollOffset;
        const nodeX = getArcX(nodeY, H);

        node.style.transform = `translate3d(${nodeX}px, ${nodeY - 20}px, 0)`;

        const distFromCenter = Math.abs(nodeY - centerY);
        const nodeOpacity = Math.max(0.2, 1 - (distFromCenter / (H * 0.45)));
        node.style.opacity = `${nodeOpacity}`;
      });

      // Determine active index based on scroll progress:
      // 0.00 - 0.33 => 0 (Engineering)
      // 0.33 - 0.66 => 1 (Products)
      // 0.66 - 1.00 => 2 (Academy)
      let newIndex = 0;
      if (progress >= 0.66) {
        newIndex = 2;
      } else if (progress >= 0.33) {
        newIndex = 1;
      }

      if (newIndex !== activeIndex) {
        setActiveDivision(newIndex);
      }
    }

    // Curved Motion Clock Roll: Content slides along a curved arc trajectory!
    function setActiveDivision(newIndex: number) {
      activeIndex = newIndex;

      // Update node active state
      nodes.forEach((node, i) => {
        const isActive = i === newIndex;
        node.classList.toggle('active', isActive);
        node.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // Update Editorial Content Panels
      panels.forEach((panel, i) => {
        panel.classList.remove('past', 'active', 'future');
        if (i < newIndex) {
          panel.classList.add('past');
        } else if (i === newIndex) {
          panel.classList.add('active');
        } else {
          panel.classList.add('future');
        }
      });

      // Update Isometric 3D Visual Scenes with Matching Rolling States
      scenes.forEach((scene, i) => {
        scene.classList.remove('past', 'active', 'future');
        if (i < newIndex) {
          scene.classList.add('past');
        } else if (i === newIndex) {
          scene.classList.add('active');
        } else {
          scene.classList.add('future');
        }
      });
    }

    // Scroll listener for sticky 300vh runway (Desktop only)
    function handleScroll() {
      if (!realm) return;
      if (isMobileView()) {
        // On mobile, reset inline styles on nodes so CSS takes full control
        nodes.forEach((node) => {
          node.style.transform = '';
          node.style.opacity = '';
        });
        return;
      }

      const rect = realm.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const scrollableDist = realm.offsetHeight - windowHeight;

      if (scrollableDist <= 0) return;

      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, scrolled / scrollableDist));

      updateArcGeometry(progress);
    }

    function handleResize() {
      if (isMobileView()) {
        nodes.forEach((node) => {
          node.style.transform = '';
          node.style.opacity = '';
        });
      } else {
        handleScroll();
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleResize, { passive: true });

    // Initial setup
    handleScroll();

    // Node click handlers:
    // On mobile: instantly switch active panel
    // On desktop: smoothly scroll through the 300vh pinned stage
    nodes.forEach((node, index) => {
      node.addEventListener('click', () => {
        if (isMobileView()) {
          setActiveDivision(index);
          return;
        }

        if (!realm) return;
        const scrollableDist = realm.offsetHeight - window.innerHeight;
        const targetProgress = index === 0 ? 0.05 : index === 1 ? 0.50 : 0.95;
        const targetScrollY = realm.offsetTop + (targetProgress * scrollableDist);
        window.scrollTo({
          top: targetScrollY,
          behavior: 'smooth'
        });
      });
    });

    // "SCROLL TO NEXT" button handler (Desktop only)
    if (scrollNextBtn) {
      scrollNextBtn.addEventListener('click', () => {
        if (!realm) return;
        const scrollableDist = realm.offsetHeight - window.innerHeight;
        if (activeIndex < 2) {
          const nextIndex = activeIndex + 1;
          const targetProgress = nextIndex === 1 ? 0.50 : 0.95;
          const targetScrollY = realm.offsetTop + (targetProgress * scrollableDist);
          window.scrollTo({
            top: targetScrollY,
            behavior: 'smooth'
          });
        } else {
          const targetScrollY = realm.offsetTop + realm.offsetHeight + 10;
          window.scrollTo({
            top: targetScrollY,
            behavior: 'smooth'
          });
        }
      });
    }
  }

  // Lifecycle initialization
  initCircularArcSection();
  document.addEventListener('astro:page-load', initCircularArcSection);
</script>

