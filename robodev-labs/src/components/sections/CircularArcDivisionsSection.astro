                  <circle cx="140" cy="70" r="5" fill="#FFFFFF" />
                  <circle cx="140" cy="70" r="10" fill="none" stroke="#D4D4D4" opacity="0.6" />
                </svg>
                <div class="bus-beacon-ping">
                  <span class="ping-ring"></span>
