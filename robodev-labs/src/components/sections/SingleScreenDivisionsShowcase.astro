---
/**
 * SingleScreenDivisionsShowcase.astro
 * 
 * Unified One-Screen-Height Ecosystem Section with Fixed Left Arc Navbar:
 * - Confined strictly inside this section (NOT floating across the entire page).
 * - Smoothly pops out from the left as the user scrolls from the ecosystem into this section.
 * - Extra-wide, thick, continuous futuristic arc silhouette on the left with watch dial styling.
 * - Guaranteed zero overlap with content (offset by 390px left margin on desktop).
 * - Shows ONLY the active division view at any given time (Client Engineering, Product Studio, RoboDev Academy).
 * - Clicking the arc menu smoothly switches between the 3 views.
 * - Content is clean and focused: strictly what each division offers, with no sales CTAs like "Join Next Cohort" or "Schedule a Consultation".
 */
import Icon from '../ui/Icon.astro';
import { servicesData } from '../../data/services';
import { productsData } from '../../data/products';
import { academyData } from '../../data/academy';
---

<section class="single-screen-divisions-realm" id="ecosystem-divisions" aria-label="RoboDev Labs Core Divisions">
  <!-- Parallax Subtle Mesh & Atmosphere (Seamless with #pillars #0f172a background) -->
  <div class="divisions-stage-backdrop" aria-hidden="true">
    <div class="parallax-orb orb-blue"></div>
    <div class="parallax-orb orb-cyan"></div>
    <div class="parallax-orb orb-purple"></div>
    <div class="circuit-grid-mesh"></div>
  </div>

  <div class="divisions-theater-container">
    
    <!-- =========================================================================
         LEFT-SIDE WIDE CONTINUOUS ARC WATCH NAVBAR
         Strictly confined within this section; slides out as user scrolls in
         ========================================================================= -->
    <aside class="left-arc-navbar-frame" id="arc-watch-side-nav" aria-label="Ecosystem Division Dial">
      <div class="thick-arc-bezel">
        <!-- Watch Dial Crown Accent (Cyber Rotary Dial) -->
        <div class="arc-watch-crown" title="RoboDev Mode Dial">
          <span class="crown-notch"></span>
        </div>

        <!-- Decorative Engraved Watch Ticks along the Curved Arch -->
        <div class="dial-ticks-column" aria-hidden="true">
          <span class="arc-tick t-1"></span>
          <span class="arc-tick t-2 major"></span>
          <span class="arc-tick t-3"></span>
          <span class="arc-tick t-4 major"></span>
          <span class="arc-tick t-5"></span>
          <span class="arc-tick t-6 major"></span>
          <span class="arc-tick t-7"></span>
        </div>

        <!-- Arc Outer Neon Stroke SVG -->
        <svg class="arc-bezel-svg" viewBox="0 0 140 760" preserveAspectRatio="none" aria-hidden="true">
          <path d="M10,0 Q135,380 10,760" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="4"/>
          <path d="M10,0 Q135,380 10,760" fill="none" stroke="rgba(6,182,212,0.5)" stroke-width="2" filter="drop-shadow(0 0 8px #06b6d4)"/>
        </svg>

        <!-- Dial Content Column -->
        <div class="arc-dial-menu-body">
          <div class="dial-brand-badge">
            <span class="pulse-beacon"></span>
            <span class="brand-code">ROBODEV // OS &bull; CORE</span>
          </div>

          <!-- Menu Item 1: Client Engineering -->
          <button 
            class="arc-nav-item active" 
            data-division="services" 
            id="arc-btn-services"
            role="tab"
            aria-selected="true"
            aria-controls="panel-services"
          >
            <div class="item-icon-orb blue">
              <Icon name="layers" size={18} />
            </div>
            <div class="item-meta">
              <span class="item-index">01 / SOLUTIONS</span>
              <span class="item-name">Client Engineering</span>
              <span class="item-subtitle">Custom Software &amp; AI</span>
            </div>
            <div class="arc-active-glow blue"></div>
          </button>

          <!-- Menu Item 2: Product Studio -->
          <button 
            class="arc-nav-item" 
            data-division="products" 
            id="arc-btn-products"
            role="tab"
            aria-selected="false"
            aria-controls="panel-products"
          >
            <div class="item-icon-orb cyan">
              <Icon name="sparkles" size={18} />
            </div>
            <div class="item-meta">
              <span class="item-index">02 / VENTURES</span>
              <span class="item-name">Product Studio</span>
              <span class="item-subtitle">Proprietary Products: Busly</span>
            </div>
            <div class="arc-active-glow cyan"></div>
          </button>

          <!-- Menu Item 3: RoboDev Academy -->
          <button 
            class="arc-nav-item" 
            data-division="academy" 
            id="arc-btn-academy"
            role="tab"
            aria-selected="false"
            aria-controls="panel-academy"
          >
            <div class="item-icon-orb purple">
              <Icon name="users" size={18} />
            </div>
            <div class="item-meta">
              <span class="item-index">03 / ACADEMY</span>
              <span class="item-name">RoboDev Academy</span>
              <span class="item-subtitle">Talent &amp; Mentorship</span>
            </div>
            <div class="arc-active-glow purple"></div>
          </button>

          <!-- Active Division Progress Dial Footer -->
          <div class="dial-meter-footer">
            <span class="meter-caption">DISPLAY CHANNEL</span>
            <span class="meter-val" id="arc-dial-status-txt">01 &bull; CLIENT ENGINEERING</span>
          </div>
        </div>
      </div>
    </aside>

    <!-- =========================================================================
         RIGHT-SIDE VIEWPORT STAGE: ONLY THE ACTIVE DIVISION IS RENDERED
         Offset cleanly by 390px on desktop to guarantee zero overlap with arc navbar
         ========================================================================= -->
    <main class="divisions-viewport-stage">
      
      <!-- ==================== VIEW 1: CLIENT ENGINEERING ==================== -->
      <div 
        class="division-panel-view active" 
        id="panel-services" 
        role="tabpanel" 
        aria-labelledby="arc-btn-services"
      >
        <header class="panel-header">
          <div class="panel-eyebrow blue">
            <span class="indicator-dot blue"></span>
            Division 01 &bull; Custom Software &amp; Intelligent Systems
          </div>
          <h2 class="panel-title">Client Engineering</h2>
          <p class="panel-desc">
            Production-grade software delivery engineered for scalability, high concurrency, and measurable business impact.
          </p>
        </header>

        <!-- Offerings Grid: Cleanly presenting what this division provides -->
        <div class="offerings-cards-grid services-2x2">
          {servicesData.map((service) => (
            <div class="offering-box">
              <div class="box-top">
                <div class="box-icon-wrap blue">
                  <Icon name={service.icon} size={20} />
                </div>
                <span class="box-badge">{service.badge}</span>
              </div>
              <h3 class="box-title">{service.title}</h3>
              <p class="box-tagline">{service.tagline}</p>
              
              <ul class="box-caps-list">
                {service.capabilities.slice(0, 3).map((cap) => (
                  <li>
                    <Icon name="check" size={14} class="check-blue" />
                    <span>{cap}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- ==================== VIEW 2: PRODUCT STUDIO ==================== -->
      <div 
        class="division-panel-view" 
        id="panel-products" 
        role="tabpanel" 
        aria-labelledby="arc-btn-products"
      >
        <header class="panel-header">
          <div class="panel-eyebrow cyan">
            <span class="indicator-dot cyan"></span>
            Division 02 &bull; Proprietary Ventures &amp; Smart Mobility
          </div>
          <h2 class="panel-title">Product Studio</h2>
          <p class="panel-desc">
            We invent, validate, and scale our own technology products. Our flagship venture, <strong>Busly</strong>, solves urban public transport chaos.
          </p>
        </header>

        <!-- Products Offerings Display -->
        <div class="products-studio-display">
          <!-- Flagship: Busly Spotlight Card -->
          <div class="busly-flagship-card">
            <div class="flagship-badge-row">
              <span class="status-live-pill">
                <span class="live-dot"></span>
                Incubating Flagship
              </span>
              <span class="category-pill">Urban Mobility OS</span>
            </div>

            <div class="flagship-title-block">
              <div class="busly-symbol">
                <Icon name="zap" size={24} />
              </div>
              <div>
                <h3 class="busly-heading">BUSLY</h3>
                <span class="busly-sub">Smart Public Transit &amp; Fleet Telemetry</span>
              </div>
            </div>

            <p class="flagship-description">
              An intelligent urban mobility platform providing live vehicle GPS tracking, precise arrival predictions, and intuitive route navigation to eliminate public transit uncertainty for commuters and fleet operators.
            </p>

            <div class="flagship-highlights-grid">
              <div class="highlight-item">
                <Icon name="check" size={15} class="check-cyan" />
                <span>Real-time GPS fleet telemetry with sub-15s precision</span>
              </div>
              <div class="highlight-item">
                <Icon name="check" size={15} class="check-cyan" />
                <span>Intelligent commuter arrival prediction engine</span>
              </div>
              <div class="highlight-item">
                <Icon name="check" size={15} class="check-cyan" />
                <span>Offline-first mobile client architecture</span>
              </div>
              <div class="highlight-item">
                <Icon name="check" size={15} class="check-cyan" />
                <span>Operator telemetry dashboard for route efficiency</span>
              </div>
            </div>
          </div>

          <!-- Studio Incubation Pipeline Card -->
          <div class="studio-pipeline-card">
            <span class="pipeline-badge">Venture Pipeline &bull; Active R&amp;D</span>
            <h4 class="pipeline-title">Autonomous Tools &amp; Edge Systems</h4>
            <p class="pipeline-desc">
              Active prototyping of internal software utilities, edge telemetry sensors, and developer platforms engineered to create compounding technology IP.
            </p>
            <div class="pipeline-capabilities-list">
              <div class="pipeline-cap-item">
                <Icon name="check" size={14} class="check-cyan" />
                <span>Edge sensor integration &amp; IoT fleet relays</span>
              </div>
              <div class="pipeline-cap-item">
                <Icon name="check" size={14} class="check-cyan" />
                <span>Automated dispatch &amp; route optimization models</span>
              </div>
              <div class="pipeline-cap-item">
                <Icon name="check" size={14} class="check-cyan" />
                <span>Developer tooling and internal accelerator SDKs</span>
              </div>
            </div>
            <div class="pipeline-tags">
              <span class="p-tag">Edge Computing</span>
              <span class="p-tag">Developer Tooling</span>
              <span class="p-tag">Venture IP</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ==================== VIEW 3: ROBODEV ACADEMY ==================== -->
      <div 
        class="division-panel-view" 
        id="panel-academy" 
        role="tabpanel" 
        aria-labelledby="arc-btn-academy"
      >
        <header class="panel-header">
          <div class="panel-eyebrow purple">
            <span class="indicator-dot purple"></span>
            Division 03 &bull; Hands-On Engineering Education
          </div>
          <h2 class="panel-title">RoboDev Academy</h2>
          <p class="panel-desc">
            We bridge academic theory and production software through hands-on code immersions, direct engineering mentorship, and real production sprints.
          </p>
        </header>

        <!-- Academy Offerings Grid: 3 Programs -->
        <div class="offerings-cards-grid academy-3col">
          {academyData.map((program) => (
            <div class="offering-box academy-box">
              <div class="box-top">
                <div class="box-icon-wrap purple">
                  <Icon name="users" size={20} />
                </div>
                <span class="box-badge purple">{program.badge}</span>
              </div>
              <h3 class="box-title">{program.title}</h3>
              <span class="target-aud">{program.targetAudience}</span>
              <p class="box-tagline">{program.description}</p>
              
              <ul class="box-caps-list">
                {program.focusAreas.map((area) => (
                  <li>
                    <Icon name="check" size={14} class="check-purple" />
                    <span>{area}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

    </main>
  </div>
</section>

<script>
  function initSingleScreenShowcase() {
    const section = document.getElementById('ecosystem-divisions');
    const sideNav = document.getElementById('arc-watch-side-nav');
    const navButtons = document.querySelectorAll<HTMLButtonElement>('.arc-nav-item');
    const panels = document.querySelectorAll<HTMLElement>('.division-panel-view');
    const statusTxt = document.getElementById('arc-dial-status-txt');

    if (!section || !sideNav || !navButtons.length || !panels.length) return;

    const divisions = [
      { id: 'services', label: '01 • CLIENT ENGINEERING' },
      { id: 'products', label: '02 • PRODUCT STUDIO' },
      { id: 'academy', label: '03 • ROBODEV ACADEMY' },
    ];

    let currentIndex = 0;

    function activateDivision(index: number) {
      currentIndex = index;
      navButtons.forEach((btn, i) => {
        const isActive = i === index;
        btn.classList.toggle('active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach((panel, i) => {
        panel.classList.toggle('active', i === index);
      });

      if (statusTxt && divisions[index]) {
        statusTxt.textContent = divisions[index].label;
      }
    }

    // Button clicks on the arc dial
    navButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        activateDivision(index);
      });
    });

    // Keyboard navigation when user is focused inside this section
    section.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        activateDivision((currentIndex + 1) % divisions.length);
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        activateDivision((currentIndex - 1 + divisions.length) % divisions.length);
      } else if (e.key === '1') {
        activateDivision(0);
      } else if (e.key === '2') {
        activateDivision(1);
      } else if (e.key === '3') {
        activateDivision(2);
      }
    });

    // Reveal navbar smoothly when scrolling into this section
    function checkVisibility() {
      const rect = section.getBoundingClientRect();
      const windowHeight = window.innerHeight;

      // Reveal when section enters viewport from above or below
      if (rect.top <= windowHeight * 0.72 && rect.bottom >= windowHeight * 0.2) {
        sideNav.classList.add('visible');
      } else {
        sideNav.classList.remove('visible');
      }
    }

    // Scroll listener + IntersectionObserver for reliable triggers
    window.addEventListener('scroll', checkVisibility, { passive: true });
    checkVisibility();

    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            sideNav.classList.add('visible');
          } else {
            // Only remove if we're completely outside
            const rect = section.getBoundingClientRect();
            if (rect.top > window.innerHeight || rect.bottom < 0) {
              sideNav.classList.remove('visible');
            }
          }
        });
      }, { threshold: 0.25 });
      obs.observe(section);
    }
  }

  initSingleScreenShowcase();
  document.addEventListener('astro:page-load', initSingleScreenShowcase);
</script>

<style>
  /* =========================================================================
     SINGLE-SCREEN DIVISIONS SHOWCASE FOUNDATION
     Height: 100vh locked screen height, completely contained ecosystem section
     ========================================================================= */
  .single-screen-divisions-realm {
    position: relative;
    width: 100%;
    min-height: 100vh;
    height: 100vh;
    background-color: #0f172a; /* Seamless identical background to #pillars */
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0;
    margin: 0;
  }

  /* Parallax Background Ambient Atmosphere */
  .divisions-stage-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .parallax-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.16;
  }

  .orb-blue { top: 15%; left: 12%; width: 500px; height: 500px; background: #2563eb; }
  .orb-cyan { bottom: 10%; right: 10%; width: 550px; height: 550px; background: #06b6d4; }
  .orb-purple { top: 40%; left: 45%; width: 450px; height: 450px; background: #a855f7; }

  .circuit-grid-mesh {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 36px 36px;
  }

  /* Theater Container */
  .divisions-theater-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    max-width: 1680px;
    margin: 0 auto;
    padding: 1.5rem 3rem;
  }

  /* -------------------------------------------------------------------------
     LEFT-SIDE WIDE CONTINUOUS ARC WATCH NAVBAR
     Confined strictly inside this section; slides out as user arrives
     ------------------------------------------------------------------------- */
  .left-arc-navbar-frame {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) translateX(-115%);
    width: 360px;
    height: 88vh;
    max-height: 680px;
    z-index: 50;
    opacity: 0;
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.75s ease;
    pointer-events: none;
  }

  .left-arc-navbar-frame.visible {
    transform: translateY(-50%) translateX(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* Thick Arc Bezel Outer Shell: Dramatic convex elliptical arch */
  .thick-arc-bezel {
    position: relative;
    width: 100%;
    height: 100%;
    background: linear-gradient(150deg, rgba(15, 23, 42, 0.98) 0%, rgba(8, 14, 26, 0.99) 100%);
    border: 2px solid rgba(255, 255, 255, 0.12);
    border-left: none;
    border-radius: 0 160px 160px 0 / 0 50% 50% 0; /* Sweeping convex arch */
    box-shadow: 
      0 25px 60px rgba(0, 0, 0, 0.9),
      12px 0 45px rgba(6, 182, 212, 0.22),
      inset 0 1px 2px rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(24px);
    padding: 2.5rem 2.2rem 2.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Cyber Rotary Watch Crown Accent */
  .arc-watch-crown {
    position: absolute;
    top: 35px;
    right: 28px;
    width: 38px;
    height: 14px;
    background: linear-gradient(180deg, #475569 0%, #1e293b 100%);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
  }

  .crown-notch {
    width: 20px;
    height: 4px;
    background: repeating-linear-gradient(90deg, #94a3b8 0px, #94a3b8 2px, transparent 2px, transparent 4px);
  }

  /* Dial Ticks along the arch edge */
  .dial-ticks-column {
    position: absolute;
    right: 12px;
    top: 15%;
    bottom: 15%;
    width: 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: none;
  }

  .arc-tick {
    display: block;
    width: 8px;
    height: 1px;
    background: rgba(255, 255, 255, 0.2);
  }

  .arc-tick.major {
    width: 12px;
    height: 2px;
    background: #06b6d4;
    box-shadow: 0 0 6px #06b6d4;
  }

  /* Decorative SVG Arc Line */
  .arc-bezel-svg {
    position: absolute;
    right: -2px;
    top: 0;
    bottom: 0;
    width: 60px;
    height: 100%;
    pointer-events: none;
  }

  /* Menu Body */
  .arc-dial-menu-body {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: relative;
    z-index: 5;
    max-width: 290px;
  }

  .dial-brand-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .pulse-beacon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #06b6d4;
    box-shadow: 0 0 8px #06b6d4;
    animation: beaconPulse 2s infinite ease-in-out;
  }

  @keyframes beaconPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(0.8); opacity: 0.4; }
  }

  .brand-code {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
    font-weight: var(--font-weight-semibold);
  }

  /* Menu Item Buttons */
  .arc-nav-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
    text-align: left;
    cursor: pointer;
    position: relative;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .arc-nav-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .arc-nav-item.active {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .item-icon-orb {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .item-icon-orb.blue { color: #60a5fa; }
  .item-icon-orb.cyan { color: #38bdf8; }
  .item-icon-orb.purple { color: #c084fc; }

  .arc-nav-item.active .item-icon-orb.blue { background: rgba(37, 99, 235, 0.25); box-shadow: 0 0 12px rgba(37, 99, 235, 0.5); }
  .arc-nav-item.active .item-icon-orb.cyan { background: rgba(6, 182, 212, 0.25); box-shadow: 0 0 12px rgba(6, 182, 212, 0.5); }
  .arc-nav-item.active .item-icon-orb.purple { background: rgba(168, 85, 247, 0.25); box-shadow: 0 0 12px rgba(168, 85, 247, 0.5); }

  .item-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    overflow: hidden;
  }

  .item-index {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .item-name {
    font-size: 0.94rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .arc-nav-item.active .item-name {
    color: var(--raw-white);
  }

  .item-subtitle {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .arc-active-glow {
    position: absolute;
    right: 0;
    top: 20%;
    bottom: 20%;
    width: 4px;
    border-radius: 4px 0 0 4px;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .arc-active-glow.blue { background: #3b82f6; box-shadow: 0 0 8px #3b82f6; }
  .arc-active-glow.cyan { background: #06b6d4; box-shadow: 0 0 8px #06b6d4; }
  .arc-active-glow.purple { background: #a855f7; box-shadow: 0 0 8px #a855f7; }

  .arc-nav-item.active .arc-active-glow {
    opacity: 1;
  }

  .dial-meter-footer {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
