---
/**
 * RoboDev Academy — Reusable Workshop Course Page Template
 * Direct Coursera information architecture reference with RoboDev brand identity.
 * Clean 2-column hero, full-width details strip, sticky section nav, single-column main content.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Icon from '../../components/ui/Icon.astro';
import Logo from '../../components/common/Logo.astro';
import type { Workshop } from '../../data/workshops';
import { siteConfig } from '../../config/site';

export interface Props {
  course: Workshop;
}

const { course } = Astro.props;

const pageUrl = `${siteConfig.url}/academy/courses/${course.slug}`;
const bookingUrl = course.paymentUrl ?? course.registrationUrl;

/* ── Derive dynamic registration status from course.status ── */
const registrationLabel =
  course.status === 'open'
    ? 'Registration Open'
    : course.status === 'upcoming'
      ? 'Registration Opening Soon'
      : 'Workshop Completed';

const ctaLabel = course.isFree ? 'Enroll for Free' : 'Book a Seat →';

/* ── Sticky navbar enroll CTA button text ── */
const stickyEnrollPrice = course.price.replace(/^NPR\s*/i, '').trim();
const stickyEnrollButtonText = course.isFree
  ? 'Enroll for Free'
  : course.price.toLowerCase() === 'coming soon'
    ? 'Coming Soon'
    : `Enroll for NPR ${stickyEnrollPrice}`;

/* ── JSON-LD: BreadcrumbList + Course schemas (SEO preserved) ── */
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Academy',
        item: `${siteConfig.url}/academy`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Courses',
        item: `${siteConfig.url}/academy/courses`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: course.shortTitle ?? course.title,
        item: pageUrl,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: course.title,
    description: course.description,
    url: pageUrl,
    provider: {
      '@type': 'Organization',
      name: siteConfig.name,
      url: siteConfig.url,
    },
    instructor: course.instructor
      ? {
          '@type': 'Person',
          name: course.instructor,
          jobTitle: course.instructorTitle,
        }
      : undefined,
    courseMode: course.format.toLowerCase().includes('online') ? 'online' : 'blended',
    educationalLevel: course.level,
    timeRequired: course.duration,
    offers: {
      '@type': 'Offer',
      price: course.isFree ? '0' : (course.price.replace(/[^0-9.]/g, '') || '0'),
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
      url: bookingUrl,
    },
    teaches: course.outcomes ?? [],
  },
];
---

<BaseLayout
  title={`${course.title} — RoboDev Academy`}
  description={course.tagline ?? course.description}
>
  <!-- Structured data (No visible breadcrumbs rendered in HTML) -->
  {jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <div class="wt-page">
    <!-- ================================================================
         1. HERO SECTION (Clean 2-column desktop layout)
         ================================================================ -->
    <header class="wt-hero">
      <Container>
        <div class="wt-hero-grid">
          <!-- LEFT -->
          <div class="wt-hero-left">
            <p class="wt-hero-category">RoboDev Academy · Workshop</p>
            <h1 class="wt-hero-title">{course.title}</h1>
            <p class="wt-hero-desc">{course.tagline ?? course.description}</p>

            {course.instructor && (
              <p class="wt-hero-byline">
                Taught by <strong>{course.instructor}</strong>
                {course.instructorTitle && <span class="wt-hero-byline-role"> · {course.instructorTitle}</span>}
              </p>
            )}

            <div class="wt-hero-facts">
              <span class="wt-fact">
                <span class="wt-fact-icon" aria-hidden="true">◈</span>
                {course.level}
              </span>
              <span class="wt-fact-sep" aria-hidden="true">·</span>
              <span class="wt-fact">
                <span class="wt-fact-icon" aria-hidden="true">◷</span>
                {course.duration}
              </span>
              <span class="wt-fact-sep" aria-hidden="true">·</span>
              <span class="wt-fact">
                <span class="wt-fact-icon" aria-hidden="true">⬡</span>
                {course.format}
              </span>
              {course.hasCertificate && (
                <>
                  <span class="wt-fact-sep" aria-hidden="true">·</span>
                  <span class="wt-fact wt-fact-cert">
                    <span class="wt-fact-icon" aria-hidden="true">✦</span>
                    Free certificate
                  </span>
                </>
              )}
            </div>

            <p class="wt-hero-seats">⚡ Limited seats available</p>

            <!-- Mobile CTA in hero -->
            <div class="wt-hero-mobile-cta">
              <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="wt-btn-primary wt-btn-full">
                {ctaLabel}
              </a>
            </div>
          </div>

          <!-- RIGHT: Contrasting Enrollment Card -->
          <aside class="wt-enroll-card" aria-label="Workshop enrollment card">
            <div class="wt-card-header">
              <span class="wt-card-badge">{course.format.split('·')[0].trim()}</span>
              <span class="wt-card-status">{registrationLabel}</span>
            </div>

            <div class="wt-card-price">
              <span class="wt-price-main">{course.isFree ? 'Free' : course.price}</span>
              <span class="wt-price-note">{course.isFree ? '100% Free · No payment required' : 'One-time registration'}</span>
            </div>

            <a
              href={bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="wt-btn-primary wt-btn-full wt-btn-card"
              id="hero-enroll-cta"
            >
              <span>{ctaLabel}</span>
            </a>

            <p class="wt-card-seats-note">Limited seats available</p>

            {course.hasCertificate && (
              <div class="wt-card-cert-row">
                <svg class="wt-card-cert-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                </svg>
                <span>Free certificate included</span>
              </div>
            )}

            {course.includes && course.includes.length > 0 && (
              <div class="wt-card-includes">
                <p class="wt-card-includes-label">This workshop includes:</p>
                <ul class="wt-card-includes-list">
                  {course.includes.map((item) => (
                    <li>
                      <span class="wt-check-icon" aria-hidden="true">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="wt-card-meta">
              <div class="wt-card-meta-row">
                <span class="wt-card-meta-key">Schedule</span>
                <span class="wt-card-meta-val">{course.date ?? 'Announced soon'}</span>
              </div>
              <div class="wt-card-meta-row">
                <span class="wt-card-meta-key">Duration</span>
                <span class="wt-card-meta-val">{course.duration}</span>
              </div>
              <div class="wt-card-meta-row">
                <span class="wt-card-meta-key">Format</span>
                <span class="wt-card-meta-val">{course.format}</span>
              </div>
              <div class="wt-card-meta-row">
                <span class="wt-card-meta-key">Language</span>
                <span class="wt-card-meta-val">{course.language ?? 'English'}</span>
              </div>
            </div>
          </aside>
        </div>
      </Container>
    </header>

    <!-- ================================================================
         2. HORIZONTAL DETAILS STRIP (Prominent Card Component)
         ================================================================ -->
    <section class="wt-details-strip" aria-label="Workshop facts at a glance">
      <Container>
        <div class="wt-strip-card">
          <div class="wt-strip-grid">
            <div class="wt-strip-fact">
              <span class="wt-strip-label">Workshop type</span>
              <span class="wt-strip-val">{course.format.split('·')[0].trim()}</span>
            </div>
            <div class="wt-strip-fact">
              <span class="wt-strip-label">Certificate</span>
              <span class="wt-strip-val">{course.hasCertificate ? 'Free included' : 'None'}</span>
            </div>
            <div class="wt-strip-fact">
              <span class="wt-strip-label">Level</span>
              <span class="wt-strip-val">{course.level}</span>
            </div>
            <div class="wt-strip-fact">
              <span class="wt-strip-label">Duration</span>
              <span class="wt-strip-val">{course.duration}</span>
            </div>
            <div class="wt-strip-fact">
              <span class="wt-strip-label">Schedule</span>
              <span class="wt-strip-val">{course.date ?? 'Announced soon'}</span>
            </div>
          </div>
        </div>
      </Container>
    </section>

    <!-- ================================================================
         3. STICKY SECTION NAV (Full-width clean navigation)
         When active/scrolled: shows top bar with Logo, Workshop Name & Enroll Button
         ================================================================ -->
    <nav class="wt-section-nav" aria-label="Page sections" id="wt-section-nav">
      <!-- Active Top Component -->
      <div class="wt-nav-top-bar" id="wt-nav-top-bar" aria-label="Workshop quick action bar">
        <Container>
          <div class="wt-top-bar-inner">
            <div class="wt-top-bar-left">
              <a href="/" class="wt-top-bar-logo" aria-label="RoboDev Labs Home">
                <Logo height={28} />
              </a>
            </div>
            <div class="wt-top-bar-center">
              <span class="wt-top-bar-title" title={course.title}>{course.title}</span>
            </div>
            <div class="wt-top-bar-right">
              <a
                href={bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="wt-btn-primary wt-top-bar-btn"
                id="sticky-top-enroll-cta"
              >
                <span>{stickyEnrollButtonText}</span>
              </a>
            </div>
          </div>
        </Container>
      </div>

      <!-- Bottom tab links row -->
      <div class="wt-nav-tabs-bar">
        <Container>
          <div class="wt-nav-inner">
            <a href="#about" class="wt-nav-link wt-nav-link--active">About</a>
            {course.outcomes && course.outcomes.length > 0 && <a href="#outcomes" class="wt-nav-link">Outcomes</a>}
            {course.skills && course.skills.length > 0 && <a href="#skills" class="wt-nav-link">Skills</a>}
            {course.tools && course.tools.length > 0 && <a href="#tools" class="wt-nav-link">Tools</a>}
            <a href="#details" class="wt-nav-link">Details</a>
            {course.curriculum && course.curriculum.length > 0 && <a href="#curriculum" class="wt-nav-link">Curriculum</a>}
            {course.instructor && <a href="#instructor" class="wt-nav-link">Instructor</a>}
            {course.faqs && course.faqs.length > 0 && <a href="#faq" class="wt-nav-link">FAQ</a>}
          </div>
        </Container>
      </div>
    </nav>

    <!-- ================================================================
         4. MAIN CONTENT (Single-column readable width, no dead spacer)
         ================================================================ -->
    <main class="wt-main" id="about">
      <Container>
        <div class="wt-content-col">

          <!-- 4.1 WHAT YOU'LL LEARN -->
          {course.outcomes && course.outcomes.length > 0 && (
            <section id="outcomes" class="wt-section" aria-labelledby="outcomes-heading">
              <h2 id="outcomes-heading" class="wt-section-title">What you'll learn</h2>
              <div class="wt-outcomes-grid">
                {course.outcomes.map((outcome) => (
                  <div class="wt-outcome-row">
                    <span class="wt-outcome-check" aria-hidden="true">✓</span>
                    <p class="wt-outcome-text">{outcome}</p>
                  </div>
                ))}
              </div>

              <!-- Practical work / What you will build (if available) -->
              {course.whatYouWillBuild && course.whatYouWillBuild.length > 0 && (
                <div class="wt-build-block">
                  <h3 class="wt-subhead">Deliverables you will build</h3>
                  <div class="wt-build-list">
                    {course.whatYouWillBuild.map((item, idx) => (
                      <div class="wt-build-item">
                        <span class="wt-build-num">0{idx + 1}</span>
                        <p class="wt-build-text">{item}</p>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </section>
          )}

          <!-- 4.2 SKILLS YOU'LL GAIN -->
          {course.skills && course.skills.length > 0 && (
            <>
              <hr class="wt-divider" />
              <section id="skills" class="wt-section" aria-labelledby="skills-heading">
                <h2 id="skills-heading" class="wt-section-title">Skills you'll gain</h2>
                <div class="wt-skills-wrap">
                  {course.skills.map((skill) => (
                    <span class="wt-skill-tag">{skill}</span>
                  ))}
                </div>
              </section>
            </>
          )}

          <!-- 4.3 TOOLS YOU'LL USE -->
          {course.tools && course.tools.length > 0 && (
            <>
              <hr class="wt-divider" />
              <section id="tools" class="wt-section" aria-labelledby="tools-heading">
                <h2 id="tools-heading" class="wt-section-title">Tools you'll use</h2>
                <div class="wt-tools-wrap">
                  {course.tools.map((tool) => (
                    <span class="wt-tool-tag">{tool}</span>
                  ))}
                </div>
              </section>
            </>
          )}

          <!-- 4.4 DETAILS TO KNOW (Includes compact Certificate) -->
          <hr class="wt-divider" />
          <section id="details" class="wt-section" aria-labelledby="details-heading">
            <h2 id="details-heading" class="wt-section-title">Details to know</h2>
            <div class="wt-details-grid">
              <div class="wt-detail-block">
                <span class="wt-detail-label">Format</span>
                <span class="wt-detail-val">{course.format}</span>
              </div>
              <div class="wt-detail-block">
                <span class="wt-detail-label">Duration</span>
                <span class="wt-detail-val">{course.duration}</span>
              </div>
              <div class="wt-detail-block">
                <span class="wt-detail-label">Skill level</span>
                <span class="wt-detail-val">{course.level}</span>
              </div>
              <div class="wt-detail-block">
                <span class="wt-detail-label">Date &amp; Schedule</span>
                <span class="wt-detail-val">{course.date ?? 'Date to be announced'}</span>
              </div>
              <div class="wt-detail-block">
                <span class="wt-detail-label">Language</span>
                <span class="wt-detail-val">{course.language ?? 'English'}</span>
              </div>
              <div class="wt-detail-block">
                <span class="wt-detail-label">Access</span>
                <span class="wt-detail-val">{course.isFree ? 'Free admission' : course.price}</span>
              </div>
            </div>

            <!-- Compact Certificate block (honest, without employer/credential claims) -->
            {course.hasCertificate && (
              <div class="wt-cert-block">
                <div class="wt-cert-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                  </svg>
                </div>
                <div class="wt-cert-text">
                  <p class="wt-cert-title">Free certificate included</p>
                  <p class="wt-cert-desc">Receive a RoboDev Academy certificate after completing the workshop.</p>
                </div>
              </div>
            )}
          </section>

          <!-- 4.5 ABOUT THIS WORKSHOP (with expandable Read more) -->
          <hr class="wt-divider" />
          <section class="wt-section" aria-labelledby="about-heading">
            <h2 id="about-heading" class="wt-section-title">About this workshop</h2>
            <p class="wt-body-text">{course.description}</p>
            {course.longDescription && (
              <details class="wt-read-more">
                <summary class="wt-read-more-trigger">Read more</summary>
                <div class="wt-read-more-body">
                  <p class="wt-body-text">{course.longDescription}</p>
                </div>
              </details>
            )}

            <!-- Target audience & Prerequisites -->
            {((course.targetAudience && course.targetAudience.length > 0) || (course.prerequisites && course.prerequisites.length > 0)) && (
              <div class="wt-two-col-section">
                {course.targetAudience && course.targetAudience.length > 0 && (
                  <div>
                    <h3 class="wt-subhead">Who this is for</h3>
                    <ul class="wt-check-list">
                      {course.targetAudience.map((item) => (
                        <li>
                          <span class="wt-check-icon" aria-hidden="true">✓</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {course.prerequisites && course.prerequisites.length > 0 && (
                  <div>
                    <h3 class="wt-subhead">Prerequisites</h3>
                    <ul class="wt-check-list">
                      {course.prerequisites.map((item) => (
                        <li>
                          <span class="wt-check-icon" aria-hidden="true">✓</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}
          </section>

          <!-- 4.6 WORKSHOP CURRICULUM -->
          {course.curriculum && course.curriculum.length > 0 && (
            <>
              <hr class="wt-divider" />
              <section id="curriculum" class="wt-section" aria-labelledby="curriculum-heading">
                <div class="wt-curriculum-head">
                  <h2 id="curriculum-heading" class="wt-section-title">Workshop curriculum</h2>
                  <span class="wt-curriculum-meta">{course.curriculum.length} parts · {course.duration}</span>
                </div>
                <div class="wt-accordion">
                  {course.curriculum.map((module, idx) => (
                    <details class="wt-module" open={idx === 0}>
                      <summary class="wt-module-bar">
                        <div class="wt-module-bar-left">
                          <span class="wt-module-num">0{idx + 1}</span>
                          <span class="wt-module-title">{module.title}</span>
                        </div>
                        <span class="wt-module-chevron" aria-hidden="true">
                          <Icon name="chevron-right" size={16} />
                        </span>
                      </summary>
                      <div class="wt-module-body">
                        <ul class="wt-lesson-list">
                          {module.lessons.map((lesson) => (
                            <li class="wt-lesson">
                              <span class="wt-lesson-bullet" aria-hidden="true">—</span>
                              <span>{lesson.title}</span>
                              {lesson.duration && <span class="wt-lesson-dur">{lesson.duration}</span>}
                            </li>
                          ))}
                        </ul>
                      </div>
                    </details>
                  ))}
                </div>
              </section>
            </>
          )}

          <!-- 4.7 INSTRUCTOR / OFFERED BY -->
          {course.instructor && (
            <>
              <hr class="wt-divider" />
              <section id="instructor" class="wt-section" aria-labelledby="instructor-heading">
                <p class="wt-eyebrow">Offered by RoboDev Academy</p>
                <h2 id="instructor-heading" class="wt-section-title">Instructor</h2>
                <div class="wt-instructor-row">
                  <div class="wt-instructor-avatar" aria-hidden="true">
                    <span>{course.instructor.split(' ').map((n: string) => n[0]).join('')}</span>
                  </div>
                  <div class="wt-instructor-info">
                    <p class="wt-instructor-name">{course.instructor}</p>
                    {course.instructorTitle && <p class="wt-instructor-role">{course.instructorTitle}</p>}
                    {course.instructorBio && <p class="wt-instructor-bio">{course.instructorBio}</p>}
                  </div>
                </div>
              </section>
            </>
          )}

          <!-- 4.8 OPTIONAL SOCIAL PROOF (Renders nothing when arrays are empty) -->
          {course.testimonials && course.testimonials.length > 0 && (
            <>
              <hr class="wt-divider" />
              <section class="wt-section" aria-labelledby="testimonials-heading">
                <h2 id="testimonials-heading" class="wt-section-title">What participants say</h2>
                <div class="wt-testimonials-grid">
                  {course.testimonials.map((t) => (
                    <blockquote class="wt-testimonial">
                      <p class="wt-testimonial-quote">"{t.quote}"</p>
                      <footer class="wt-testimonial-footer">
                        <span class="wt-testimonial-name">{t.name}</span>
                        {t.role && <span class="wt-testimonial-role">{t.role}</span>}
                      </footer>
                    </blockquote>
                  ))}
                </div>
              </section>
            </>
          )}

          <!-- 4.9 FREQUENTLY ASKED QUESTIONS -->
          {course.faqs && course.faqs.length > 0 && (
            <>
              <hr class="wt-divider" />
              <section id="faq" class="wt-section" aria-labelledby="faq-heading">
                <h2 id="faq-heading" class="wt-section-title">Frequently asked questions</h2>
                <div class="wt-faq-stack">
                  {course.faqs.map((faq, idx) => (
                    <details class="wt-faq" open={idx === 0}>
                      <summary class="wt-faq-q">
                        <span>{faq.q}</span>
                        <span class="wt-module-chevron" aria-hidden="true">
                          <Icon name="chevron-right" size={15} />
                        </span>
                      </summary>
                      <div class="wt-faq-a">
                        <p>{faq.a}</p>
                      </div>
                    </details>
                  ))}
                </div>
              </section>
            </>
          )}

          <!-- FINAL CTA BLOCK -->
          <div class="wt-final-cta">
            <div class="wt-final-cta-content">
              <h2 class="wt-final-cta-title">Ready to join this workshop?</h2>
              <p class="wt-final-cta-note">Limited seats available · {course.isFree ? '100% Free registration' : course.price}</p>
            </div>
            <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="wt-btn-primary wt-btn-lg" id="bottom-enroll-cta">
              {ctaLabel}
            </a>
          </div>

        </div>
      </Container>
    </main>

    <!-- ================================================================
         MOBILE FIXED BOTTOM ENROLL BAR
         ================================================================ -->
    <div class="wt-mobile-bar" aria-label="Mobile enrollment action">
      <div class="wt-mobile-bar-inner">
        <div class="wt-mobile-bar-text">
          <span class="wt-mobile-price">{course.isFree ? 'Free' : course.price}</span>
          <span class="wt-mobile-note">{course.hasCertificate ? 'Free certificate included' : 'Interactive workshop'}</span>
        </div>
        <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="wt-btn-primary wt-btn-sm" id="mobile-enroll-cta">
          {ctaLabel}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  /* Sticky nav active link highlighting on scroll */
  const navLinks = document.querySelectorAll('.wt-nav-link');
  const sections = document.querySelectorAll('main[id], section[id]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((l) => l.classList.remove('wt-nav-link--active'));
          const active = document.querySelector(`.wt-nav-link[href="#${entry.target.id}"]`);
          if (active) active.classList.add('wt-nav-link--active');
        }
      });
    },
    { rootMargin: '-25% 0px -65% 0px' }
  );

  sections.forEach((s) => observer.observe(s));

  /* Elevation shadow and top-bar activation when sticky nav passes hero */
  const nav = document.getElementById('wt-section-nav');
  const hero = document.querySelector('.wt-hero');
  if (nav && hero) {
    const updateNavState = (isPastHero: boolean) => {
      nav.classList.toggle('wt-nav--scrolled', isPastHero);
      nav.classList.toggle('wt-nav--active', isPastHero);
    };

    const heroObserver = new IntersectionObserver(
      ([e]) => {
        updateNavState(!e.isIntersecting);
      },
      { threshold: 0 }
    );
    heroObserver.observe(hero);

    // Initial check on load or restore
