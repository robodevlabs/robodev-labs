---
/**
 * AcademyGrid — small grid fragments + blueprint lines.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props as Props;
---
<svg
  class={`academy-grid ${className}`}
  viewBox="0 0 400 260"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="xMidYMid slice"
>
  <defs>
    <pattern id="academy-grid-pat" width="28" height="28" patternUnits="userSpaceOnUse">
      <path d="M28 0 H0 V28" stroke="currentColor" stroke-width="1" opacity="0.35" />
    </pattern>
  </defs>
  <rect x="0" y="0" width="400" height="260" fill="url(#academy-grid-pat)" opacity="0.5" />
  <path d="M0 52 H400 M0 130 H400 M0 208 H400" stroke="currentColor" stroke-width="1" opacity="0.18" />
  <path d="M80 0 V260 M200 0 V260 M320 0 V260" stroke="currentColor" stroke-width="1" opacity="0.14" />
  <circle cx="80" cy="52" r="3" fill="currentColor" opacity="0.5" />
  <circle cx="320" cy="208" r="3" fill="currentColor" opacity="0.4" />
  <path d="M80 52 L200 130 L320 208" stroke="currentColor" stroke-width="1" stroke-dasharray="5 5" opacity="0.3" />
</svg>

<style>
  .academy-grid {
    display: block;
    color: rgba(212, 212, 212, 0.4);
    pointer-events: none;
  }
</style>
