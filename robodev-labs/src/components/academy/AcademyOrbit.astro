---
/**
 * AcademyOrbit — thin orbital arcs, rings, nodes.
 * Lightweight, uses currentColor / CSS vars. Decorative only.
 */
interface Props {
  class?: string;
  variant?: 'hero' | 'card' | 'faint';
}
const { class: className = '', variant = 'hero' } = Astro.props as Props;
---
<svg
  class={`academy-orbit academy-orbit--${variant} ${className}`}
  viewBox="0 0 400 400"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <circle cx="200" cy="200" r="150" stroke="currentColor" stroke-width="1" stroke-dasharray="4 6" opacity="0.35" />
  <circle cx="200" cy="200" r="110" stroke="currentColor" stroke-width="1" opacity="0.22" />
  <circle cx="200" cy="200" r="66" stroke="currentColor" stroke-width="1" opacity="0.16" />
  <ellipse cx="200" cy="200" rx="150" ry="52" stroke="currentColor" stroke-width="1" opacity="0.18" transform="rotate(-18 200 200)" />
  <circle cx="200" cy="200" r="3.5" fill="currentColor" opacity="0.9" />
  <circle cx="350" cy="200" r="3" fill="currentColor" opacity="0.5" />
  <circle cx="118" cy="285" r="2.5" fill="currentColor" opacity="0.4" />
  <circle cx="242" cy="98" r="2" fill="currentColor" opacity="0.35" />
  <path d="M200 50 L200 62 M200 338 L200 350 M50 200 L62 200 M338 200 L350 200" stroke="currentColor" stroke-width="1" opacity="0.5" />
</svg>

<style>
  .academy-orbit {
    display: block;
    color: rgba(212, 212, 212, 0.5);
    pointer-events: none;
  }
  .academy-orbit--hero { color: rgba(181, 213, 173, 0.35); }
  .academy-orbit--card { color: rgba(181, 213, 173, 0.28); }
  .academy-orbit--faint { color: rgba(212, 212, 212, 0.22); }
</style>
