---
import type { ButtonVariant, ButtonSize } from '../../types';
import { cn } from '../../lib/utils';

export interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: any;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  disabled = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props as Props;

const isLink = Boolean(href);
const Component = isLink ? 'a' : 'button';
---

<Component
  class={cn(
    'button-primitive',
    `variant-${variant}`,
    `size-${size}`,
    disabled && 'is-disabled',
    className
  )}
  href={isLink && !disabled ? href : undefined}
  type={!isLink ? type : undefined}
  disabled={!isLink && disabled}
  aria-disabled={disabled ? 'true' : undefined}
  tabindex={disabled && isLink ? -1 : undefined}
  {...rest}
>
  <slot />
</Component>

<style>
  .button-primitive {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-md);
    cursor: pointer;
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-standard);
    border: 1px solid transparent;
    user-select: none;
    white-space: nowrap;
  }

  .size-sm {
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-body-small);
  }

  .size-md {
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-size-body);
  }

  .size-lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-body-large);
  }

  .variant-primary {
    background-color: var(--color-brand);
    color: #ffffff;
    border-color: var(--color-brand);
  }

  .variant-primary:hover:not(.is-disabled) {
    background-color: var(--color-brand-hover);
    border-color: var(--color-brand-hover);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }

  .variant-primary:active:not(.is-disabled) {
    background-color: var(--color-brand-active);
  }

  .variant-secondary {
    background-color: var(--color-surface);
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .variant-secondary:hover:not(.is-disabled) {
    background-color: var(--color-surface-hover);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .variant-outline {
    background-color: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .variant-outline:hover:not(.is-disabled) {
    background-color: var(--color-surface);
    border-color: var(--color-border-bright);
    color: var(--color-accent);
  }

  .variant-ghost {
    background-color: transparent;
    color: var(--color-text-secondary);
    border-color: transparent;
  }

  .variant-ghost:hover:not(.is-disabled) {
    background-color: var(--color-surface);
    color: var(--color-text);
  }

  .is-disabled,
  .button-primitive:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
    box-shadow: none !important;
  }

  .button-primitive:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
  }
</style>
