# =============================================================================
# RoboDev Labs — .gitignore
# =============================================================================

# Build output
dist/

# Generated Astro types
.astro/

# Dependencies
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
.env
.env.production
.env*.local

# macOS-specific files
.DS_Store
*.pem

# JetBrains
.idea/

# VS Code (optional — remove if you want to commit .vscode settings)
# .vscode/

# TypeScript build info
*.tsbuildinfo

# Netlify CLI state
.netlify

# Vercel (in case)
.vercel

# Coverage
/coverage
