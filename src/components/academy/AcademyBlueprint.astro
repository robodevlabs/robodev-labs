---
/**
 * AcademyBlueprint — larger abstract brand illustration:
 * open geometric ring + connected nodes + architectural geometry.
 * Built from SVG/CSS, sharp and lightweight. No stock imagery.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props as Props;
---
<svg
  class={`academy-blueprint ${className}`}
  viewBox="0 0 560 560"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <!-- outer open ring -->
  <circle cx="280" cy="280" r="210" stroke="currentColor" stroke-width="1.2" opacity="0.32" stroke-dasharray="2 8" stroke-linecap="round" />
  <circle cx="280" cy="280" r="160" stroke="currentColor" stroke-width="1" opacity="0.22" />
  <path d="M70 280 A210 210 0 0 1 280 70" stroke="currentColor" stroke-width="1.5" opacity="0.5" stroke-linecap="round" />
  <!-- inner technical diagram -->
  <rect x="180" y="200" width="200" height="140" stroke="currentColor" stroke-width="1" opacity="0.28" />
  <rect x="200" y="220" width="160" height="100" stroke="currentColor" stroke-width="1" opacity="0.18" stroke-dasharray="6 6" />
  <path d="M180 270 H380 M280 200 V340" stroke="currentColor" stroke-width="1" opacity="0.16" />
  <!-- connected nodes -->
  <circle cx="180" cy="200" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6" />
  <circle cx="380" cy="200" r="4" fill="currentColor" opacity="0.6" />
  <circle cx="180" cy="340" r="4" fill="currentColor" opacity="0.45" />
  <circle cx="380" cy="340" r="5" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.55" />
  <circle cx="280" cy="270" r="6" fill="currentColor" opacity="0.85" />
  <circle cx="280" cy="270" r="14" stroke="currentColor" stroke-width="1" opacity="0.35" />
  <!-- elongated forms + annotations -->
  <path d="M110 420 L200 380 L200 400" stroke="currentColor" stroke-width="1" opacity="0.3" />
  <path d="M450 140 L380 180" stroke="currentColor" stroke-width="1" opacity="0.3" />
  <path d="M120 120 H170 M120 120 V170" stroke="currentColor" stroke-width="1" opacity="0.35" />
  <circle cx="120" cy="120" r="3" fill="currentColor" opacity="0.6" />
  <g font-family="monospace" font-size="11" letter-spacing="1.5" fill="currentColor" opacity="0.38">
    <text x="390" y="135">SYS.01</text>
    <text x="95" y="445">BLD//STUDIO</text>
    <text x="250" y="395">COORD 280:270</text>
  </g>
  <!-- crosshairs -->
  <path d="M272 270 H288 M280 262 V278" stroke="currentColor" stroke-width="1" opacity="0.7" />
</svg>

<style>
  .academy-blueprint {
    display: block;
    color: rgba(212, 212, 212, 0.55);
    pointer-events: none;
  }
</style>
