---
/**
 * AcademyNodes — scattered node field with thin connections.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props as Props;
---
<svg
  class={`academy-nodes ${className}`}
  viewBox="0 0 300 200"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path d="M20 160 L80 100 L150 120 L220 60 L280 90" stroke="currentColor" stroke-width="1" opacity="0.28" />
  <path d="M80 100 L90 40 M150 120 L150 170" stroke="currentColor" stroke-width="1" opacity="0.2" stroke-dasharray="3 4" />
  <circle cx="20" cy="160" r="3" fill="currentColor" opacity="0.55" />
  <circle cx="80" cy="100" r="4" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6" />
  <circle cx="80" cy="100" r="1.6" fill="currentColor" opacity="0.8" />
  <circle cx="150" cy="120" r="3" fill="currentColor" opacity="0.5" />
  <circle cx="220" cy="60" r="5" fill="none" stroke="currentColor" stroke-width="1" opacity="0.45" />
  <circle cx="220" cy="60" r="1.8" fill="currentColor" opacity="0.7" />
  <circle cx="280" cy="90" r="2.5" fill="currentColor" opacity="0.45" />
  <circle cx="90" cy="40" r="2" fill="currentColor" opacity="0.35" />
</svg>

<style>
  .academy-nodes {
    display: block;
    color: rgba(181, 213, 173, 0.5);
    pointer-events: none;
  }
</style>
