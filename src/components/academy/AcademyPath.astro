---
/**
 * AcademyPath — thin progression path for How It Works.
 * Animates via stroke-dashoffset when parent gets .is-visible.
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props as Props;
---
<svg
  class={`academy-path ${className}`}
  viewBox="0 0 900 120"
  fill="none"
  aria-hidden="true"
  focusable="false"
  preserveAspectRatio="none"
>
  <path
    class="academy-path__track"
    d="M40 60 C 250 60, 250 20, 450 40 S 650 100, 860 60"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-dasharray="6 6"
    opacity="0.35"
    stroke-linecap="round"
  />
  <path
    class="academy-path__draw"
    d="M40 60 C 250 60, 250 20, 450 40 S 650 100, 860 60"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  />
  <g class="academy-path__nodes">
    <circle cx="40" cy="60" r="6" fill="var(--color-pepper-medium, #31473A)" stroke="currentColor" stroke-width="1.5" />
    <circle cx="40" cy="60" r="2.5" fill="currentColor" />
    <circle cx="450" cy="40" r="6" fill="var(--color-pepper-medium, #31473A)" stroke="currentColor" stroke-width="1.5" />
    <circle cx="450" cy="40" r="2.5" fill="currentColor" />
    <circle cx="860" cy="60" r="6" fill="var(--color-pepper-medium, #31473A)" stroke="currentColor" stroke-width="1.5" />
    <circle cx="860" cy="60" r="2.5" fill="currentColor" />
  </g>
</svg>

<style>
  .academy-path {
    display: block;
    width: 100%;
    height: 72px;
    color: rgba(181, 213, 173, 0.7);
    overflow: visible;
  }
  .academy-path__draw {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    opacity: 0.9;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }
  :global(.is-visible) .academy-path__draw {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .academy-path__draw {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
  }
</style>
