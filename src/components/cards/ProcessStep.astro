---
import type { ProcessStage } from '../../data/process';
import Heading from '../ui/Heading.astro';
import Text from '../ui/Text.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  stage: ProcessStage;
}

const { stage } = Astro.props;
---

<div class="process-card">
  <div class="stage-number">{stage.step}</div>
  <div class="stage-info">
    <Heading level="h3" size="h4" class="stage-title">
      {stage.title}
    </Heading>
    <p class="stage-subtitle">{stage.subtitle}</p>
    <Text variant="small" class="stage-desc">
      {stage.description}
    </Text>
  </div>

  <div class="stage-deliverables">
    <span class="deliv-label">Key Deliverables</span>
    <ul class="deliv-list">
      {
        stage.deliverables.map((item) => (
          <li>
            <Icon name="chevron-right" size={14} class="deliv-icon" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .process-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    position: relative;
    transition: all var(--duration-normal) var(--ease-standard);
  }

  .process-card:hover {
    border-color: rgba(6, 182, 212, 0.4);
    background: rgba(30, 41, 59, 0.85);
    transform: translateY(-2px);
  }

  .stage-number {
    font-family: var(--font-mono);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    opacity: 0.9;
    margin-bottom: var(--space-3);
  }

  .stage-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .stage-title {
    color: var(--color-text);
  }

  .stage-subtitle {
    font-size: var(--font-size-caption);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  .stage-desc {
    color: var(--color-text-secondary);
    line-height: var(--line-height-normal);
  }

  .stage-deliverables {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
  }

  .deliv-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .deliv-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .deliv-list li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-caption);
    color: var(--color-text-secondary);
  }

  .deliv-icon {
    color: var(--color-accent);
    flex-shrink: 0;
  }
</style>
