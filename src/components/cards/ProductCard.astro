---
import type { ProductItem } from '../../data/products';
import Heading from '../ui/Heading.astro';
import Text from '../ui/Text.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import Divider from '../ui/Divider.astro';

export interface Props {
  product: ProductItem;
}

const { product } = Astro.props;
---

<div class={`product-card ${product.isFeatured ? 'is-featured' : ''}`}>
  <div class="product-top">
    <div class="product-meta">
      <span class="product-badge">{product.badge}</span>
      <span class={`status-pill status-${product.status.toLowerCase().replace(/\s+/g, '-')}`}>
        <span class="status-indicator"></span>
        {product.status}
      </span>
    </div>

    <div class="product-header">
      <Heading level="h3" size={product.isFeatured ? 'h2' : 'h3'} class="product-name">
        {product.name}
      </Heading>
      <p class="product-tagline">{product.tagline}</p>
    </div>

    <Text variant="body" class="product-description">
      {product.description}
    </Text>
  </div>

  {
    product.metrics && product.metrics.length > 0 && (
      <div class="metrics-grid">
        {product.metrics.map((metric) => (
          <div class="metric-item">
            <span class="metric-value">{metric.value}</span>
            <span class="metric-label">{metric.label}</span>
          </div>
        ))}
      </div>
    )
  }

  <div class="product-highlights">
    <span class="highlights-title">Core Architecture & Features</span>
    <ul class="highlights-list">
      {
        product.highlights.map((feat) => (
          <li>
            <Icon name="check" size={16} class="check-icon" />
            <span>{feat}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="product-tags">
    {product.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
  </div>

  <div class="product-footer">
    <Button
      variant={product.isFeatured ? 'primary' : 'secondary'}
      size="md"
      href={product.ctaUrl || '#contact'}
      class="product-cta"
    >
      <span>{product.ctaText || 'Learn More'}</span>
      <Icon name="arrow-right" size={16} />
    </Button>
  </div>
</div>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-8);
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    transition: all var(--duration-normal) var(--ease-standard);
  }

  .product-card.is-featured {
    border-color: rgba(37, 99, 235, 0.4);
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.85) 0%, rgba(15, 23, 42, 0.98) 100%);
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6), 0 0 30px -5px rgba(37, 99, 235, 0.15);
  }

  .product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-brand), var(--color-accent), transparent);
    opacity: 0.8;
  }

  .product-card:hover {
    transform: translateY(-4px);
    border-color: rgba(6, 182, 212, 0.5);
    box-shadow: 0 24px 48px -12px rgba(0, 0, 0, 0.7), 0 0 35px -5px rgba(6, 182, 212, 0.2);
  }

  .product-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .product-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .product-badge {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    letter-spacing: var(--letter-spacing-wider);
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(6, 182, 212, 0.1);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(6, 182, 212, 0.25);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--font-size-caption);
    font-family: var(--font-mono);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border);
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #eab308;
  }

  .status-in-development .status-indicator {
    background-color: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .status-live .status-indicator {
    background-color: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  .product-name {
    color: var(--color-text);
  }

  .product-tagline {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    line-height: var(--line-height-snug);
  }

  .product-description {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-bold);
    color: var(--raw-white);
  }

  .metric-label {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
  }

  .product-highlights {
    margin-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .highlights-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wide);
  }

  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--font-size-body-small);
    color: var(--color-text-secondary);
    line-height: var(--line-height-snug);
  }

  .check-icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-6);
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    color: var(--color-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border-subtle);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
  }

  .product-footer {
    margin-top: var(--space-8);
    display: flex;
  }

  .product-cta {
    width: 100%;
    justify-content: center;
  }
</style>
