---
/**
 * CinematicBridge.astro
 * 
 * Production-quality, scroll-driven cinematic camera journey:
 * Hero World -> Approach Monumental Architectural Bridge -> Fly through/underneath
 * -> Dark atmospheric under-bridge portal -> Light emerges -> Seamlessly reveals next section.
 *
 * Built with native Astro, HTML, CSS transforms/perspectives & lightweight RAF scroll listener.
 */
---

<section class="cinematic-portal-section" id="cinematic-portal" aria-label="Cinematic Transition Journey">
  <div class="cinematic-sticky-stage">
    <!-- 3D Camera Frustum World Container -->
    <div class="camera-world" id="camera-world">

      <!-- LAYER 1: Deep Sky, Atmospheric Fog & Majestic Distant Mountains -->
      <div class="world-layer layer-background" id="layer-bg">
        <div class="sky-gradient"></div>
        <div class="horizon-glow"></div>
        
        <!-- Distant Mountain Peaks Layer (Snowy White Peaks) -->
        <svg class="distant-mountains-back" viewBox="0 0 1920 600" preserveAspectRatio="none">
          <defs>
            <linearGradient id="mtnBackGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.95"/>
              <stop offset="35%" stop-color="#e8eef2" stop-opacity="0.9"/>
              <stop offset="75%" stop-color="#c8d5dc" stop-opacity="0.85"/>
              <stop offset="100%" stop-color="#a0b5be" stop-opacity="1"/>
            </linearGradient>
          </defs>
          <path d="M0,600 L0,320 L180,210 L340,310 L520,150 L680,260 L850,90 L980,220 L1140,110 L1320,270 L1500,160 L1680,280 L1820,190 L1920,250 L1920,600 Z" fill="url(#mtnBackGrad)"/>
        </svg>

        <!-- Mid-Distance Mountain Ridges with Snow Caps & Green Hill Transition -->
        <svg class="distant-mountains-front" viewBox="0 0 1920 600" preserveAspectRatio="none">
          <defs>
            <linearGradient id="mtnFrontGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9"/>
              <stop offset="25%" stop-color="#d8e4e8" stop-opacity="0.95"/>
              <stop offset="55%" stop-color="#5a8a4a" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#3d6b2e" stop-opacity="1"/>
            </linearGradient>
            <linearGradient id="snowCapHighlight" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.9"/>
              <stop offset="100%" stop-color="#e0eef5" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <!-- Mountain mass with green-to-snow gradient -->
          <path d="M0,600 L0,410 L140,330 L280,390 L440,260 L580,340 L720,220 L840,310 L940,190 L1080,320 L1220,230 L1380,350 L1540,240 L1700,340 L1840,270 L1920,330 L1920,600 Z" fill="url(#mtnFrontGrad)"/>
          <!-- Snow cap highlights on peak ridges -->
          <path d="M440,260 L510,300 L580,340 L720,220 L780,265 L840,310 L940,190 L1010,255 L1080,320" stroke="url(#snowCapHighlight)" stroke-width="3" fill="none"/>
          <path d="M1220,230 L1300,290 L1380,350 L1540,240 L1620,290 L1700,340" stroke="url(#snowCapHighlight)" stroke-width="3" fill="none"/>
        </svg>

        <!-- Rolling Green Hills in the valleys -->
        <svg class="distant-megastructures" viewBox="0 0 1600 500" preserveAspectRatio="none">
          <defs>
            <linearGradient id="hillGrad1" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#4a7c35" stop-opacity="0.9"/>
              <stop offset="100%" stop-color="#2d5a1e" stop-opacity="1"/>
            </linearGradient>
            <linearGradient id="hillGrad2" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#3d6b2e" stop-opacity="0.95"/>
              <stop offset="100%" stop-color="#1e4012" stop-opacity="1"/>
            </linearGradient>
          </defs>
          <!-- Back rolling hills -->
          <path d="M0,500 L0,380 Q200,300 400,350 Q600,290 800,340 Q1000,290 1200,330 Q1400,280 1600,340 L1600,500 Z" fill="url(#hillGrad1)" opacity="0.85"/>
          <!-- Front rolling hills -->
          <path d="M0,500 L0,430 Q250,360 500,400 Q750,350 1000,390 Q1250,345 1600,400 L1600,500 Z" fill="url(#hillGrad2)" opacity="0.95"/>
        </svg>

        <!-- Valley Fog & Low Atmospheric Mist -->
        <div class="atmospheric-haze"></div>
      </div>

      <!-- LAYER 2: Midground Water Fjord, Shoreline Cliffs & Rock Promontories -->
      <div class="world-layer layer-midground" id="layer-mid">
        <!-- Deep Reflective Water Basin -->
        <div class="water-expanse">
          <div class="water-light-line"></div>
          <div class="water-specular-shimmer"></div>
          <!-- Water Surface Reflections & Ripple Waves -->
          <div class="water-ripples">
            <span class="ripple r-1"></span>
            <span class="ripple r-2"></span>
            <span class="ripple r-3"></span>
            <span class="ripple r-4"></span>
          </div>
        </div>

        <!-- Monumental Rocky Cliffs & Fjord Promontories Flanking the Water -->
        <div class="fjord-cliffs-system">
          <!-- Left Rocky Cliff Complex (Earthy/Sandstone Colors) -->
          <svg class="cliff-svg cliff-left" viewBox="0 0 600 700" preserveAspectRatio="none">
            <defs>
              <linearGradient id="cliffRockGradL" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#c8956a" stop-opacity="0.9"/>
                <stop offset="35%" stop-color="#a0714a" stop-opacity="0.95"/>
                <stop offset="70%" stop-color="#7a5535" stop-opacity="1"/>
                <stop offset="100%" stop-color="#5c3d20"/>
              </linearGradient>
              <linearGradient id="cliffHighlightL" x1="0%" y1="0%" x2="80%" y2="80%">
                <stop offset="0%" stop-color="#e8b888" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#c8956a" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <!-- Craggy earthy cliff contours -->
            <polygon points="0,0 240,160 380,290 320,380 460,490 390,570 540,700 0,700" fill="url(#cliffRockGradL)"/>
            <polygon points="0,180 180,260 220,380 340,460 270,550 420,700 0,700" fill="#6b4426" opacity="0.75"/>
            <!-- Chiseled sandstone edge highlights -->
            <polyline points="0,0 240,160 380,290 320,380 460,490 390,570 540,700" stroke="url(#cliffHighlightL)" stroke-width="2.5" fill="none"/>
            <polyline points="180,260 220,380 340,460" stroke="rgba(220,160,100,0.25)" stroke-width="1.5" fill="none"/>
          </svg>

          <!-- Right Rocky Cliff Complex (Earthy/Sandstone Colors) -->
          <svg class="cliff-svg cliff-right" viewBox="0 0 600 700" preserveAspectRatio="none">
            <defs>
              <linearGradient id="cliffRockGradR" x1="100%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color="#c8956a" stop-opacity="0.9"/>
                <stop offset="35%" stop-color="#a0714a" stop-opacity="0.95"/>
                <stop offset="70%" stop-color="#7a5535" stop-opacity="1"/>
                <stop offset="100%" stop-color="#5c3d20"/>
              </linearGradient>
              <linearGradient id="cliffHighlightR" x1="100%" y1="0%" x2="20%" y2="80%">
                <stop offset="0%" stop-color="#e8b888" stop-opacity="0.6"/>
                <stop offset="100%" stop-color="#c8956a" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <!-- Craggy earthy cliff contours -->
            <polygon points="600,0 360,160 220,290 280,380 140,490 210,570 60,700 600,700" fill="url(#cliffRockGradR)"/>
            <polygon points="600,180 420,260 380,380 260,460 330,550 180,700 600,700" fill="#6b4426" opacity="0.75"/>
            <!-- Chiseled sandstone edge highlights -->
            <polyline points="600,0 360,160 220,290 280,380 140,490 210,570 60,700" stroke="url(#cliffHighlightR)" stroke-width="2.5" fill="none"/>
            <polyline points="420,260 380,380 260,460" stroke="rgba(220,160,100,0.25)" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
      </div>

      <!-- LAYER 3: MONUMENTAL ARCHITECTURAL BRIDGE (The Hero Structure) -->
      <!-- Positioned in true 3D perspective to zoom, tower, and pass overhead -->
      <div class="world-layer layer-bridge-system" id="layer-bridge">
        <div class="bridge-3d-rig" id="bridge-rig">

          <!-- Architectural Suspension Arches & Crown Cables -->
          <div class="bridge-suspension-arches">
            <svg class="arch-cable-svg" viewBox="0 0 1400 300" preserveAspectRatio="none">
              <!-- Left catenary parabolic suspension cable (black wire) -->
              <path d="M0,280 Q320,60 620,280" fill="none" stroke="rgba(20, 15, 10, 0.9)" stroke-width="3.5" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.8))"/>
              <!-- Right catenary parabolic suspension cable (black wire) -->
              <path d="M780,280 Q1080,60 1400,280" fill="none" stroke="rgba(20, 15, 10, 0.9)" stroke-width="3.5" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.8))"/>
              <!-- Center sweeping tension arch (dark wire) -->
              <path d="M300,280 Q700,-20 1100,280" fill="none" stroke="rgba(30, 20, 10, 0.7)" stroke-width="2.5"/>
            </svg>
          </div>

          <!-- Bridge Deck & Superstructure (Upper Roadway, Truss & Ribs) -->
          <div class="bridge-superstructure">
            <div class="superstructure-line top-spine"></div>
            <!-- High density architectural stay-cable fan array -->
            <div class="truss-cables-row">
              <span class="cable c1"></span>
              <span class="cable c2"></span>
              <span class="cable c3"></span>
              <span class="cable c4"></span>
              <span class="cable c5"></span>
              <span class="cable c6"></span>
              <span class="cable c7"></span>
              <span class="cable c8"></span>
              <span class="cable c9"></span>
              <span class="cable c10"></span>
              <span class="cable c11"></span>
              <span class="cable c12"></span>
            </div>
            <div class="deck-main-beam">
              <div class="deck-light-strip"></div>
              <div class="deck-luminescent-edge"></div>
            </div>
          </div>

          <!-- Massive Architectural Pylon Towers (Left and Right Piers) -->
          <div class="monolithic-pylon pylon-left">
            <div class="pylon-shaft"></div>
            <div class="pylon-accent"></div>
            <div class="pylon-bracket top-br"></div>
            <div class="pylon-bracket bot-br"></div>
          </div>
          <div class="monolithic-pylon pylon-right">
            <div class="pylon-shaft"></div>
            <div class="pylon-accent"></div>
            <div class="pylon-bracket top-br"></div>
            <div class="pylon-bracket bot-br"></div>
          </div>

          <!-- Bridge Foundation Piers rooted in the deep water -->
          <div class="substructure-piers">
            <div class="water-pier pier-left">
              <div class="pier-reflection"></div>
            </div>
            <div class="water-pier pier-right">
              <div class="pier-reflection"></div>
            </div>
          </div>

          <!-- Bridge Underside (Covers viewport as camera passes underneath) -->
          <div class="bridge-undercarriage" id="bridge-undercarriage">
            <div class="ribbed-soffit">
              <div class="transverse-rib r1"></div>
              <div class="transverse-rib r2"></div>
              <div class="transverse-rib r3"></div>
              <div class="transverse-rib r4"></div>
              <div class="transverse-rib r5"></div>
              <div class="transverse-rib r6"></div>
              <div class="transverse-rib r7"></div>
              <div class="transverse-rib r8"></div>
              <div class="transverse-rib r9"></div>
              <div class="transverse-rib r10"></div>
            </div>
            <!-- Overhead longitudinal expansion joints with soft glowing cyan conduits -->
            <div class="soffit-conduits">
              <span class="conduit c-left"></span>
              <span class="conduit c-center"></span>
              <span class="conduit c-right"></span>
            </div>
          </div>

        </div>
      </div>

      <!-- LAYER 4: The Portal Dark Tunnel & Exit Light Emergence -->
      <div class="world-layer layer-portal" id="layer-portal">
        <div class="tunnel-occlusion" id="tunnel-occlusion"></div>
        <div class="exit-light-source" id="exit-light">
          <div class="exit-radiant-core"></div>
          <div class="exit-volumetric-flare"></div>
        </div>
      </div>

      <!-- LAYER 5: Foreground & Extreme Depth Silhouettes -->
      <div class="world-layer layer-foreground" id="layer-fore">
        <div class="architectural-framing-edge left-fin" id="fore-left"></div>
        <div class="architectural-framing-edge right-fin" id="fore-right"></div>
      </div>

      <!-- LAYER 6: Revealed New Environment (Seamlessly matches #pillars start) -->
      <div class="world-layer layer-revealed-world" id="layer-revealed">
        <div class="revealed-ambient-glow"></div>
        <div class="revealed-matrix-grid"></div>
      </div>

      <!-- CINEMATIC STORYTELLING TYPOGRAPHY STAGES -->
      <div class="story-typography-viewport">
        <!-- Frame 1 (Approach) -->
        <div class="story-caption" id="caption-1">
          <h2 class="caption-title">Every scalable idea starts somewhere.</h2>
        </div>

        <!-- Frame 2 (Dominance / Monumental Bridge) -->
        <div class="story-caption" id="caption-2">
          <h2 class="caption-title">Then engineering gives it structure.</h2>
        </div>

        <!-- Frame 3 (Underbelly Passage) -->
        <div class="story-caption" id="caption-3">
          <h2 class="caption-title">Passing through the crucible into reality.</h2>
        </div>

        <!-- Frame 4 (Light Emergence & Gateway to Pillars) -->
        <div class="story-caption" id="caption-4">
          <h2 class="caption-title">Let’s build what comes next.</h2>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function initCinematicScroll() {
    const portal = document.getElementById('cinematic-portal');
    const bridgeRig = document.getElementById('bridge-rig');
    const undercarriage = document.getElementById('bridge-undercarriage');
    const tunnelOcclusion = document.getElementById('tunnel-occlusion');
    const exitLight = document.getElementById('exit-light');
    const layerBg = document.getElementById('layer-bg');
    const layerMid = document.getElementById('layer-mid');
    const foreLeft = document.getElementById('fore-left');
    const foreRight = document.getElementById('fore-right');
    const layerRevealed = document.getElementById('layer-revealed');

    const cap1 = document.getElementById('caption-1');
    const cap2 = document.getElementById('caption-2');
    const cap3 = document.getElementById('caption-3');
    const cap4 = document.getElementById('caption-4');

    if (!portal || !bridgeRig) return;

    // Smooth easing function for cinematic deceleration
    function easeInOutQuad(t: number) {
      return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    }

    function updateFrame() {
      const rect = portal.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const totalScrollable = rect.height - windowHeight;
      if (totalScrollable <= 0) return;

      const currentScroll = -rect.top;
      let p = currentScroll / totalScrollable;
      p = Math.max(0, Math.min(1, p));

      // -------------------------------------------------------------
      // 1. 3D CAMERA TRACKING SHOT (Forward Zoom & Passage)
      // 0.0 -> 0.65: Approach & Towering Scale
      // 0.65 -> 0.85: Passing Underneath Bridge & Overhead Soffit Occlusion
      // 0.85 -> 1.0: Emergence into Next Realm
      // -------------------------------------------------------------
      
      // Camera forward position: scale from 0.7 (distance) to 12.0 (overhead flythrough)
      let scaleVal: number;
      let translateYVal: number;
      let translateZVal: number;

      if (p < 0.65) {
        // Approaching phase
        const norm = p / 0.65;
        const eased = easeInOutQuad(norm);
        scaleVal = 0.7 + eased * 2.8; // 0.7 -> 3.5
        translateYVal = eased * 120;   // bridge sinks slightly as camera elevates
        translateZVal = eased * 400;
      } else {
        // Passing underneath & overhead phase
        const norm = (p - 0.65) / 0.35;
        scaleVal = 3.5 + norm * 8.5;  // 3.5 -> 12.0 (massive overhead engulfment)
        translateYVal = 120 - norm * 380; // fly completely underneath and up
        translateZVal = 400 + norm * 1200;
      }

      bridgeRig.style.transform = `translate3d(0px, ${translateYVal}px, ${translateZVal}px) scale(${scaleVal})`;

      // -------------------------------------------------------------
      // 2. PARALLAX DEPTH LAYERS
      // -------------------------------------------------------------
      if (layerBg) {
        layerBg.style.transform = `scale(${1 + p * 0.15}) translateY(${p * -40}px)`;
      }
      if (layerMid) {
        layerMid.style.transform = `scale(${1 + p * 0.4}) translateY(${p * 20}px)`;
      }
      if (foreLeft && foreRight) {
        // Foreground architectural fins part sideways as camera pushes past
        const forePush = Math.min(1, p / 0.4);
        foreLeft.style.transform = `translateX(${forePush * -140}px) scale(${1 + forePush * 0.3})`;
        foreRight.style.transform = `translateX(${forePush * 140}px) scale(${1 + forePush * 0.3})`;
        foreLeft.style.opacity = `${1 - p * 1.8}`;
        foreRight.style.opacity = `${1 - p * 1.8}`;
      }

      // -------------------------------------------------------------
      // 3. UNDER-BRIDGE OCCLUSION & TUNNEL DARKNESS (p: 0.60 -> 0.88)
      // -------------------------------------------------------------
      if (tunnelOcclusion) {
        if (p < 0.55) {
          tunnelOcclusion.style.opacity = '0';
        } else if (p >= 0.55 && p <= 0.78) {
          // Darken environment as we enter undercarriage
          const darkNorm = (p - 0.55) / 0.23;
          tunnelOcclusion.style.opacity = `${darkNorm * 0.95}`;
        } else {
          // Exit darkness into emergence light
          const lightNorm = (p - 0.78) / 0.22;
          tunnelOcclusion.style.opacity = `${Math.max(0, 0.95 - lightNorm * 1.4)}`;
        }
      }

      // Undercarriage overhead ceiling visibility
      if (undercarriage) {
        if (p > 0.45 && p < 0.90) {
          undercarriage.style.opacity = '1';
        } else {
          undercarriage.style.opacity = '0.1';
        }
      }

      // -------------------------------------------------------------
      // 4. EXIT LIGHT EMERGENCE (p: 0.75 -> 1.0)
      // -------------------------------------------------------------
      if (exitLight) {
        if (p < 0.72) {
          exitLight.style.opacity = '0';
          exitLight.style.transform = 'translate(-50%, -50%) scale(0.3)';
        } else {
          const exitP = (p - 0.72) / 0.28;
          exitLight.style.opacity = `${Math.min(1, exitP * 1.6)}`;
          exitLight.style.transform = `translate(-50%, -50%) scale(${0.4 + exitP * 4.5})`;
        }
      }

      // -------------------------------------------------------------
      // 5. REVEALED NEW ENVIRONMENT (Final transition seamlessly into Pillars)
      // -------------------------------------------------------------
      if (layerRevealed) {
        if (p < 0.82) {
          layerRevealed.style.opacity = '0';
        } else {
          const revP = (p - 0.82) / 0.18;
          layerRevealed.style.opacity = `${revP}`;
        }
      }

      // -------------------------------------------------------------
      // 6. CINEMATIC STORYTELLING TEXT PHASING
      // -------------------------------------------------------------
      function calcCaption(targetP: number, spread: number) {
        const dist = Math.abs(p - targetP);
        if (dist > spread) return 0;
        return Math.cos((dist / spread) * (Math.PI / 2));
      }

      if (cap1) {
        const o1 = calcCaption(0.12, 0.12);
        cap1.style.opacity = `${o1}`;
        cap1.style.transform = `translateY(${(1 - o1) * 20}px)`;
      }
      if (cap2) {
        const o2 = calcCaption(0.38, 0.13);
        cap2.style.opacity = `${o2}`;
        cap2.style.transform = `translateY(${(1 - o2) * 20}px)`;
      }
      if (cap3) {
        const o3 = calcCaption(0.68, 0.12);
        cap3.style.opacity = `${o3}`;
        cap3.style.transform = `translateY(${(1 - o3) * 20}px)`;
      }
      if (cap4) {
        const o4 = calcCaption(0.92, 0.10);
        cap4.style.opacity = `${o4}`;
        cap4.style.transform = `translateY(${(1 - o4) * 20}px)`;
      }
    }

    window.addEventListener('scroll', updateFrame, { passive: true });
    updateFrame();
  }

  // Initialize immediately & on client page load
  initCinematicScroll();
  document.addEventListener('astro:page-load', initCinematicScroll);
</script>

<style>
  /* =========================================================================
     CINEMATIC SCROLLING SECTION FOUNDATION
     Height: 450vh allows unhurried, monumental tracking shot pacing
     ========================================================================= */
  .cinematic-portal-section {
    position: relative;
    height: 450vh;
    background-color: var(--color-background-secondary);
    margin: 0;
    padding: 0;
    border: none;
    overflow: clip;
  }

  .cinematic-sticky-stage {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    perspective: 1200px;
    perspective-origin: 50% 55%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background);
  }

  /* 3D Viewport Frustum */
  .camera-world {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    pointer-events: none;
    overflow: hidden;
  }

  .world-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* -------------------------------------------------------------------------
     LAYER 1: Background Sky, Atmosphere, Mountain Ranges & Megastructures
     ------------------------------------------------------------------------- */
  .layer-background {
    z-index: 1;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .sky-gradient {
    position: absolute;
    inset: 0;
    /* Natural blue sky gradient */
    background: linear-gradient(180deg, #1a4a8a 0%, #2e6db8 25%, #5b9fd4 50%, #8dc3e8 70%, #c2dff2 85%, #daeefa 100%);
  }

  .horizon-glow {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80vw;
    height: 140px;
    background: radial-gradient(ellipse at center, rgba(220, 180, 120, 0.35) 0%, rgba(255, 200, 100, 0.1) 55%, transparent 75%);
    filter: blur(45px);
  }

  /* Alpine Peaks Layer (Deep Atmospheric Silhouette) */
  .distant-mountains-back {
    position: absolute;
    bottom: 30%;
    left: 0;
    width: 100%;
    height: 38vh;
    opacity: 0.85;
    filter: blur(1.2px);
  }

  /* Foreground Mountain Ridges with Light Highlights */
  .distant-mountains-front {
    position: absolute;
    bottom: 25%;
    left: 0;
    width: 100%;
    height: 32vh;
    opacity: 0.95;
    filter: blur(0.4px);
  }

  .distant-megastructures {
    position: absolute;
    bottom: 26%;
    left: 0;
    width: 100%;
    height: 24vh;
    opacity: 0.6;
    filter: blur(1.8px);
  }

  .atmospheric-haze {
    position: absolute;
    top: 44%;
    left: 0;
    right: 0;
    height: 28vh;
    /* Mist transitioning from sky to ground */
    background: linear-gradient(180deg, transparent 0%, rgba(180, 210, 230, 0.5) 35%, rgba(140, 185, 210, 0.75) 70%, rgba(100, 155, 185, 0.9) 100%);
  }

  /* -------------------------------------------------------------------------
     LAYER 2: Midground Water Fjord Basin, Shoreline Cliffs & Ripple Reflections
     ------------------------------------------------------------------------- */
  .layer-midground {
    z-index: 2;
    transform-origin: 50% 60%;
    will-change: transform;
  }

  .water-expanse {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 42vh;
    /* Deep river/fjord water — blue reflecting the sky */
    background: linear-gradient(180deg, #2a6090 0%, #1a4d78 45%, #0d3358 100%);
    overflow: hidden;
  }

  .water-light-line {
    position: absolute;
    top: 0;
    left: 50%;
