---
import Container from '../ui/Container.astro';
import Logo from '../common/Logo.astro';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { siteConfig } from '../../config/site';

const currentYear = new Date().getFullYear();

const socialsList = [
  { name: 'GitHub', icon: 'github', url: siteConfig.socials.github },
  { name: 'LinkedIn', icon: 'linkedin', url: siteConfig.socials.linkedin },
  { name: 'Instagram', icon: 'instagram', url: siteConfig.socials.instagram },
  { name: 'YouTube', icon: 'youtube', url: siteConfig.socials.youtube },
  { name: 'X', icon: 'twitter', url: siteConfig.socials.x },
];
---

<div id="contact" class="continuous-footer-wrapper">
  <!-- Ambient Atmospheric Back-Glow -->
  <div class="ambient-glow-layer" aria-hidden="true">
    <div class="glow-radial-orb"></div>
  </div>

  <!-- =========================================================================
       1. HIGH-IMPACT CLEAN & SIMPLE PREMIUM CTA SECTION
       ========================================================================= -->
  <section class="cta-section" aria-labelledby="cta-heading">
    <Container class="cta-inner-container">
      <div class="cta-card-wrapper">
        <div class="cta-card-glass-glow" aria-hidden="true"></div>
        <div class="cta-card-content">
          <!-- Clean Eyebrow -->
          <Eyebrow class="cta-eyebrow">READY TO BUILD</Eyebrow>

          <!-- High Impact Minimalist Headline -->
          <h2 id="cta-heading" class="cta-headline">
            Have an idea worth <span class="cta-highlight-gradient">building into reality?</span>
          </h2>

          <!-- Clean concise supporting copy -->
          <p class="cta-subtext">
            Let's turn your vision into high-impact software. We architect enduring digital solutions and product ventures.
          </p>

          <!-- Focused Action Group -->
          <div class="cta-button-group">
            <Button
              variant="primary"
              size="md"
              href={`mailto:${siteConfig.email}?subject=Project%20Inquiry%20-%20RoboDev%20Labs`}
            >
              <span>Start a conversation</span>
            </Button>

            <a href="#services" class="cta-text-link">
              <span>Explore capabilities</span>
              <span class="cta-text-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- =========================================================================
       2. DISTINCT PREMIUM FOOTER (Differentiated Deep Slate/Obsidian Tone)
       ========================================================================= -->
  <footer class="footer-main" role="contentinfo">
    <Container class="footer-inner-container">
      <!-- Top Grid: Structured Columns -->
      <div class="footer-structured-grid">
        <!-- Col 1: Brand & Identity -->
        <div class="footer-block brand-block">
          <div class="brand-logo-wrap">
            <Logo height={32} />
          </div>
          <p class="brand-mission-summary">
            A premier engineering lab and developer academy based in Nepal. We architect enduring software, develop proprietary ventures, and mentor top-tier engineering talent.
          </p>

          <!-- Active Presence Indicator -->
          <div class="location-status-badge">
            <span class="live-dot"></span>
            <span class="badge-label">Kathmandu, Nepal &bull; Global Delivery</span>
          </div>

          <!-- Social Links Row -->
          <div class="footer-social-row">
            {socialsList.map((item) => (
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="social-pill-btn"
                title={`RoboDev Labs on ${item.name}`}
                aria-label={item.name}
              >
                <Icon name={item.icon as any} size={15} />
              </a>
            ))}
          </div>
        </div>

        <!-- Col 2: Ecosystem & Solutions -->
        <div class="footer-block">
          <h3 class="footer-col-heading">ECOSYSTEM</h3>
          <ul class="footer-link-list">
            <li><a href="#services" class="footer-nav-link">Custom Software & Cloud</a></li>
            <li><a href="#services" class="footer-nav-link">AI & Intelligent Systems</a></li>
            <li><a href="#products" class="footer-nav-link">Product Studio</a></li>
            <li><a href="#products" class="footer-nav-link">Busly Transit Platform</a></li>
            <li><a href="#academy" class="footer-nav-link">RoboDev Academy</a></li>
            <li><a href="#process" class="footer-nav-link">Engineering Lifecycle</a></li>
          </ul>
        </div>

        <!-- Col 3: Company & Culture -->
        <div class="footer-block">
          <h3 class="footer-col-heading">COMPANY</h3>
          <ul class="footer-link-list">
            <li><a href="#leadership" class="footer-nav-link">Founders & Leadership</a></li>
            <li><a href="#pillars" class="footer-nav-link">Company Ecosystem</a></li>
            <li><a href="#process" class="footer-nav-link">How We Work</a></li>
            <li><a href={`mailto:${siteConfig.email}?subject=Career%20Inquiry%20-%20RoboDev%20Labs`} class="footer-nav-link">Careers & Fellowships</a></li>
            <li><a href={`mailto:${siteConfig.email}?subject=Media%20Inquiry`} class="footer-nav-link">Press & Media</a></li>
          </ul>
        </div>

        <!-- Col 4: Direct Connection -->
        <div class="footer-block contact-block">
          <h3 class="footer-col-heading">CONNECT</h3>
          <p class="connect-helper-text">
            Ready to collaborate or discuss an upcoming project?
          </p>
          <div class="quick-email-card">
            <span class="email-caption">Direct Engineer Line</span>
            <a href={`mailto:${siteConfig.email}`} class="direct-email-text">
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>

      <!-- Bottom Bar: Legal, Rights, & Security -->
      <div class="footer-bottom-strip">
        <div class="bottom-left-legal">
          <span class="copyright-text">&copy; {currentYear} {siteConfig.name}. All rights reserved.</span>
        </div>

        <div class="bottom-center-links">
          <a href="/privacy-policy" class="legal-nav-link">Privacy Policy</a>
          <span class="legal-sep">&bull;</span>
          <a href="/terms" class="legal-nav-link">Terms of Service</a>
          <span class="legal-sep">&bull;</span>
          <a href="/cookie-policy" class="legal-nav-link">Cookie Policy</a>
        </div>

        <div class="bottom-right-meta">
          <span class="craft-badge">Crafted with engineering discipline</span>
        </div>
      </div>
    </Container>
  </footer>
</div>

<style>
  /* ==========================================================================
     CONTINUOUS CTA & FOOTER WRAPPER
     ========================================================================== */
  .continuous-footer-wrapper {
    position: relative;
    /* Medium green outer wrapper */
    background-color: var(--color-pepper-dark);
    overflow-x: hidden;
    isolation: isolate;
  }

  /* --------------------------------------------------------------------------
     Ambient Atmosphere
     -------------------------------------------------------------------------- */
  .ambient-glow-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .glow-radial-orb {
    position: absolute;
    top: 0%;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(350px, 70vw, 850px);
    height: clamp(200px, 30vw, 360px);
    background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.08) 0%, rgba(212, 212, 212, 0.03) 50%, transparent 80%);
    filter: blur(60px);
    pointer-events: none;
  }

  /* --------------------------------------------------------------------------
     1. Clean, Focused Premium CTA Stage
     -------------------------------------------------------------------------- */
  .cta-section {
    position: relative;
    z-index: 2;
    padding-top: clamp(4rem, 7vw, 6rem);
    padding-bottom: clamp(3.5rem, 6vw, 5rem);
  }

  .cta-inner-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
  }

  .cta-card-wrapper {
    position: relative;
    border-radius: 24px;
    /* Dark green inner card */
    background: linear-gradient(180deg, var(--color-pepper-medium) 0%, #1e3328 100%);
    border: 1px solid var(--color-border);
    box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    padding: clamp(2.5rem, 6vw, 4.25rem) clamp(1.5rem, 5vw, 3.5rem);
    text-align: center;
    overflow: hidden;
  }

  .cta-card-glass-glow {
    position: absolute;
    top: 0;
    left: 25%;
    right: 25%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-salt-light), transparent);
  }

  .cta-card-content {
    max-width: 720px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-eyebrow {
    letter-spacing: 0.18em;
  }

  .cta-headline {
    font-family: var(--font-sans);
    font-size: clamp(2.2rem, 4.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--color-text);
    margin: 0;
  }

  .cta-highlight-gradient {
    color: var(--color-salt-light);
    background: linear-gradient(135deg, var(--color-salt-white) 0%, var(--color-salt-light) 50%, var(--color-pepper-medium) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cta-subtext {
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    max-width: 580px;
  }

  .cta-button-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.75rem;
  }

  .cta-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 200ms ease;
    cursor: pointer;
  }

  .cta-text-link:hover {
    color: var(--color-salt-white);
  }

  .cta-text-arrow {
    display: inline-block;
    transition: transform 200ms ease;
  }

  .cta-text-link:hover .cta-text-arrow {
    transform: translateX(4px);
  }

  /* --------------------------------------------------------------------------
     2. Differentiated Salt & Pepper Footer
     -------------------------------------------------------------------------- */
  .footer-main {
    position: relative;
    z-index: 2;
    padding-top: clamp(3rem, 5vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
    /* Dark green footer */
    background-color: var(--color-pepper-medium);
    border-top: 1px solid var(--color-border);
  }

  .footer-inner-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3.5vw, 2.5rem);
  }

  /* 4-Column Structured Grid */
  .footer-structured-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 0.95fr 1.15fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .footer-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Brand Block */
  .brand-logo-wrap {
    display: flex;
    align-items: center;
  }

  .brand-mission-summary {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-salt-white);
    line-height: 1.6;
    margin: 0;
    max-width: 330px;
    opacity: 0.92;
  }

  .location-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-salt-white);
    margin-top: 0.25rem;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-salt-white);
    box-shadow: 0 0 6px var(--color-salt-white);
  }

  .footer-social-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .social-pill-btn {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-salt-white);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .social-pill-btn :global(svg) {
    color: var(--color-salt-white);
  }

  .social-pill-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  .social-pill-btn:hover :global(svg) {
    color: #ffffff;
  }

  /* Nav Columns */
  .footer-col-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-salt-white);
    font-weight: 700;
    margin: 0;
  }

  .footer-link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-nav-link {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    color: var(--color-salt-white);
    opacity: 0.88;
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
    width: fit-content;
  }

  .footer-nav-link:hover {
    color: #ffffff;
    opacity: 1;
    transform: translateX(2px);
  }

  /* Connect Column */
  .connect-helper-text {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-salt-white);
    opacity: 0.88;
    line-height: 1.5;
    margin: 0;
  }

  .quick-email-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    margin-top: 0.25rem;
  }

  .email-caption {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-salt-white);
    opacity: 0.8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .direct-email-text {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-salt-white);
    text-decoration: none;
    word-break: break-all;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .direct-email-text:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* --------------------------------------------------------------------------
     Bottom Legal & Copyright Bar
     -------------------------------------------------------------------------- */
  .footer-bottom-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* User requested: use medium green color for copyright, legal links, and craft badge */
  .copyright-text {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-pepper-dark);
    letter-spacing: 0.01em;
  }

  .bottom-center-links {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .legal-nav-link {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-pepper-dark);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .legal-nav-link:hover {
    color: var(--color-salt-white);
    text-decoration: underline;
  }

  .legal-sep {
    color: var(--color-pepper-dark);
    font-size: 0.75rem;
    opacity: 0.8;
  }

  .craft-badge {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-pepper-dark);
    letter-spacing: 0.03em;
  }

  /* --------------------------------------------------------------------------
     RESPONSIVE BREAKPOINTS (Mobile-First Polish)
     -------------------------------------------------------------------------- */
  @media (max-width: 1024px) {
    .footer-structured-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 2rem;
    }

    .brand-block {
      grid-column: span 2;
    }

    .brand-mission-summary {
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .cta-section {
      padding-top: 3.25rem;
      padding-bottom: 2.5rem;
    }

    .cta-card-wrapper {
      padding: 2.25rem 1.25rem;
      border-radius: 18px;
    }

    .cta-headline {
      font-size: clamp(1.85rem, 7.5vw, 2.35rem);
      line-height: 1.18;
    }

    .cta-button-group {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    /* Compact Mobile Footer */
    .footer-main {
      padding-top: 2rem;
      padding-bottom: 1.75rem;
    }

    .footer-structured-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .footer-structured-grid > .footer-block:not(.brand-block) {
      display: none;
    }

    .brand-block {
      grid-column: span 1;
      align-items: center;
      text-align: center;
      gap: 0.75rem;
    }

    .brand-mission-summary,
    .location-status-badge {
      display: none;
    }

    .footer-social-row {
      justify-content: center;
      margin-top: 0.25rem;
    }

    .footer-bottom-strip {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-top: 1rem;
      gap: 0.5rem;
    }

    .bottom-center-links,
    .bottom-right-meta {
      display: none;
    }
  }
</style>
