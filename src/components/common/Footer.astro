---
import Logo from './Logo.astro';
import Container from '../ui/Container.astro';
import Text from '../ui/Text.astro';
import Divider from '../ui/Divider.astro';
import Icon from '../ui/Icon.astro';
import { siteConfig } from '../../config/site';

const currentYear = new Date().getFullYear();

const socialsList = [
  { name: 'GitHub', icon: 'github', url: siteConfig.socials.github },
  { name: 'LinkedIn', icon: 'linkedin', url: siteConfig.socials.linkedin },
  { name: 'X', icon: 'twitter', url: siteConfig.socials.x },
  { name: 'Instagram', icon: 'instagram', url: siteConfig.socials.instagram },
  { name: 'YouTube', icon: 'youtube', url: siteConfig.socials.youtube },
  { name: 'Facebook', icon: 'facebook', url: siteConfig.socials.facebook },
  { name: 'TikTok', icon: 'tiktok', url: siteConfig.socials.tiktok },
];
---

<footer class="site-footer">
  <Container>
    <div class="footer-top">
      <!-- Brand & Positioning Column -->
      <div class="footer-brand">
        <Logo height={42} />
        <Text variant="small" class="brand-desc">
          {siteConfig.description}
        </Text>
        <div class="brand-subtext">
          <Text variant="caption">
            Practical technology. Built for scale.
          </Text>
        </div>

        <!-- Social Icons Row -->
        <div class="footer-socials-row">
          {socialsList.map((item) => (
            <a 
              href={item.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="footer-social-circle"
              title={`Follow RoboDev Labs on ${item.name}`}
              aria-label={item.name}
            >
              <Icon name={item.icon as any} size={16} />
            </a>
          ))}
        </div>
      </div>

      <!-- 3 Public Pillars Links (Strictly no internal division 4 exposure) -->
      <div class="footer-grid">
        <div class="footer-col">
          <span class="col-title">Services</span>
          <ul class="col-list">
            <li><a href="#services" class="footer-link">Custom Software & Web Apps</a></li>
            <li><a href="#services" class="footer-link">Mobile Applications</a></li>
            <li><a href="#services" class="footer-link">AI & Workflow Automation</a></li>
            <li><a href="#services" class="footer-link">Cloud Infrastructure & APIs</a></li>
            <li><a href="#services" class="footer-link">Digital Growth Systems</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <span class="col-title">Product Studio</span>
          <ul class="col-list">
            <li>
              <a href="#products" class="footer-link product-link">
                <span>Busly</span>
                <span class="pill-mini">Transit Tech</span>
              </a>
            </li>
            <li><a href="#products" class="footer-link">Upcoming Products</a></li>
            <li><a href="#contact" class="footer-link">Co-Build With Us</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <span class="col-title">RoboDev Academy</span>
          <ul class="col-list">
            <li><a href="#academy" class="footer-link">Technical Workshops</a></li>
            <li><a href="#academy" class="footer-link">Engineering Mentorship</a></li>
            <li><a href="#academy" class="footer-link">Hackathon Preparation</a></li>
            <li><a href="#academy" class="footer-link">Project-Based Bootcamps</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <span class="col-title">Get in Touch</span>
          <ul class="col-list">
            <li>
              <a href={`mailto:${siteConfig.email}`} class="footer-link email-link">
                {siteConfig.email}
              </a>
            </li>
            <li><a href="#process" class="footer-link">Our Engineering Process</a></li>
            <li><a href="#about" class="footer-link">Company Philosophy</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <span class="col-title">Legal</span>
          <ul class="col-list">
            <li><a href="/privacy-policy" class="footer-link">Privacy Policy</a></li>
            <li><a href="/terms" class="footer-link">Terms of Service</a></li>
            <li><a href="/cookie-policy" class="footer-link">Cookie Policy</a></li>
          </ul>
        </div>
      </div>
    </div>

    <Divider class="footer-divider" />

    <div class="footer-bottom">
      <Text variant="caption">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </Text>
      <Text variant="caption" class="tagline">
        {siteConfig.tagline}
      </Text>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    background-color: var(--color-dark, #0a0a0a);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-16);
    padding-bottom: var(--space-8);
    margin-top: auto;
    color: var(--color-salt-white);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 2.8fr;
    gap: var(--space-12);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .brand-desc {
    max-width: 360px;
    color: var(--color-salt-white);
    opacity: 0.9;
    line-height: var(--line-height-normal);
  }

  .brand-subtext {
    color: var(--color-salt-white);
    opacity: 0.75;
  }

  .footer-socials-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--space-2);
    flex-wrap: wrap;
  }

  .footer-social-circle {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-salt-white);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .footer-social-circle :global(svg) {
    color: var(--color-salt-white);
  }

  .footer-social-circle:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  .footer-social-circle:hover :global(svg) {
    color: #ffffff;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-6);
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    letter-spacing: var(--letter-spacing-wide);
    text-transform: uppercase;
    color: var(--color-salt-white);
    font-weight: 700;
    margin-bottom: var(--space-4);
    display: block;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-link {
    font-size: var(--font-size-body-small);
    color: var(--color-salt-white);
    opacity: 0.88;
    transition: color var(--duration-fast) var(--ease-standard), opacity 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .footer-link:hover {
    color: #ffffff;
    opacity: 1;
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pill-mini {
    font-size: 0.65rem;
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-salt-white);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .email-link {
    word-break: break-all;
    color: var(--color-salt-white);
    font-weight: 500;
  }

  .footer-divider {
    margin-top: var(--space-12);
    margin-bottom: var(--space-6);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-bottom :global(p) {
    color: var(--color-salt-white);
    font-weight: 500;
    opacity: 0.9;
  }

  .tagline {
    font-family: var(--font-mono);
    color: var(--color-salt-white);
    font-weight: 500;
    opacity: 0.9;
  }

  @media (max-width: 1024px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
