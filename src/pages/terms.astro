---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocumentTemplate from '../components/legal/LegalDocumentTemplate.astro';
import { getLegalDocumentBySlug } from '../data/legal';

const document = getLegalDocumentBySlug('terms');

if (!document) {
  throw new Error('Missing legal document: terms');
}
---

<BaseLayout
  title="Terms of Service — RoboDev Labs"
  description={document.shortDescription}
>
  <LegalDocumentTemplate document={document} />
</BaseLayout>
